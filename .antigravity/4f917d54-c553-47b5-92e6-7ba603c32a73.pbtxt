      arguments_json: "{\"Instruction\":\"Remove the entire top announcement bar and refine header spacing and proportions in Navbar.tsx\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport { \\n  ShoppingBag, \\n  Menu, \\n  X, \\n  Phone, \\n  MessageCircle, \\n  Search\\n} from \'lucide-react\';\\nimport { BUSINESS_INFO } from \'../data/products\';\\n\\ninterface NavbarProps {\\n  currentView: string;\\n  onNavigate: (view: string) => void;\\n  inquiryCount: number;\\n  onOpenInquiryDrawer: () => void;\\n  onOpenSearch: () => void;\\n}\\n\\nexport const Navbar: React.FC<NavbarProps> = ({\\n  currentView,\\n  onNavigate,\\n  inquiryCount,\\n  onOpenInquiryDrawer,\\n  onOpenSearch,\\n}) => {\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n\\n  interface NavLinkItem {\\n    id: string;\\n    label: string;\\n    badge?: string;\\n  }\\n\\n  const navLinks: NavLinkItem[] = [\\n    { id: \'shop\', label: \'Shop\' },\\n    { id: \'new-arrivals\', label: \'New Arrivals\', badge: \'New\' },\\n    { id: \'wholesale\', label: \'Wholesale\' },\\n    { id: \'about\', label: \'About\' },\\n    { id: \'contact\', label: \'Contact\' },\\n  ];\\n\\n  const handleNavClick = (id: string) => {\\n    onNavigate(id);\\n    setMobileMenuOpen(false);\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  return (\\n    <header \\n      id=\\\"main-header\\\" \\n      className=\\\"sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-[#EAE2D7] shadow-xs\\\"\\n    >\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"flex items-center justify-between h-20 sm:h-22\\\">\\n          \\n          {/* Brand Logo */}\\n          <button\\n            id=\\\"brand-logo-btn\\\"\\n            onClick={() => handleNavClick(\'home\')}\\n            className=\\\"flex flex-col text-left group focus:outline-none py-1\\\"\\n          >\\n            <div className=\\\"flex items-center gap-1.5 sm:gap-2\\\">\\n              <span className=\\\"font-serif text-2xl sm:text-3xl font-bold tracking-tight text-[#1C1917] group-hover:text-[#8C6D37] transition-colors leading-none\\\">\\n                Pearls Elegance\\n              </span>\\n              <span className=\\\"w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#C5A059] inline-block mb-1\\\"></span>\\n            </div>\\n            <span className=\\\"text-[10px] sm:text-xs uppercase tracking-[0.24em] text-[#6B655D] font-medium mt-1\\\">\\n              Thrift Abaya Wears\\n            </span>\\n          </button>\\n\\n          {/* Desktop Navigation */}\\n          <nav id=\\\"desktop-nav\\\" className=\\\"hidden lg:flex items-center gap-8\\\">\\n            {navLinks.map((link) => {\\n              const isActive = currentView === link.id;\\n              return (\\n                <button\\n                  key={link.id}\\n                  id={`nav-link-${link.id}`}\\n                  onClick={() => handleNavClick(link.id)}\\n                  className={`relative text-sm font-medium transition-colors py-2 flex items-center gap-1.5 ${\\n                    isActive \\n                      ? \'text-[#1C1917] font-semibold\' \\n                      : \'text-[#5A544C] hover:text-[#1C1917]\'\\n                  }`}\\n                >\\n                  <span>{link.label}</span>\\n                  {link.badge && (\\n                    <span className=\\\"bg-[#FAF0DE] text-[#8C6D37] border border-[#E8D4B0] text-[10px] px-1.5 py-0.2 rounded-full font-semibold\\\">\\n                      {link.badge}\\n                    </span>\\n                  )}\\n                  {isActive && (\\n                    <span className=\\\"absolute bottom-0 left-0 right-0 h-0.5 bg-[#C5A059] rounded-full\\\" />\\n                  )}\\n                </button>\\n              );\\n            })}\\n          </nav>\\n\\n          {/* Actions: Search, Inquiry Bag, WhatsApp CTA, Mobile Menu */}\\n          <div className=\\\"flex items-center gap-2 sm:gap-3\\\">\\n            <button\\n              id=\\\"search-trigger-btn\\\"\\n              onClick={onOpenSearch}\\n              aria-label=\\\"Search catalog\\\"\\n              className=\\\"p-2.5 rounded-full text-[#4A453E] hover:bg-[#F2EBE1] hover:text-[#1C1917] transition-colors\\\"\\n              title=\\\"Search collection\\\"\\n            >\\n              <Search className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <button\\n              id=\\\"inquiry-bag-btn\\\"\\n              onClick={onOpenInquiryDrawer}\\n              aria-label=\\\"View Inquiry List\\\"\\n              className=\\\"relative p-2.5 rounded-full text-[#4A453E] hover:bg-[#F2EBE1] hover:text-[#1C1917] transition-colors\\\"\\n              title=\\\"Inquiry List\\\"\\n            >\\n              <ShoppingBag className=\\\"w-5 h-5\\\" />\\n              {inquiryCount > 0 && (\\n                <span className=\\\"absolute top-0.5 right-0.5 w-5 h-5 bg-[#C5A059] text-[#1C1917] text-[11px] font-bold rounded-full flex items-center justify-center border-2 border-[#FAF8F5]\\\">\\n                  {inquiryCount}\\n                </span>\\n              )}\\n            </button>\\n\\n            <a\\n              id=\\\"whatsapp-header-cta\\\"\\n              href={BUSINESS_INFO.whatsappUrl}\\n              target=\\\"_blank\\\"\\n              rel=\\\"noopener noreferrer\\\"\\n              className=\\\"hidden sm:inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20BE5B] text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-xs transition-all hover:shadow-md uppercase tracking-wider\\\"\\n            >\\n              <MessageCircle className=\\\"w-4 h-4 fill-white\\\" />\\n              <span>WhatsApp</span>\\n            </a>\\n\\n            {/* Mobile Menu Toggle Button */}\\n            <button\\n              id=\\\"mobile-menu-toggle-btn\\\"\\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\\n              aria-label=\\\"Toggle Navigation Menu\\\"\\n              className=\\\"lg:hidden p-2.5 rounded-xl text-[#1C1917] hover:bg-[#F2EBE1] transition-colors\\\"\\n            >\\n              {mobileMenuOpen ? <X className=\\\"w-6 h-6\\\" /> : <Menu className=\\\"w-6 h-6\\\" />}\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Mobile Navigation Drawer */}\\n      {mobileMenuOpen && (\\n        <div \\n          id=\\\"mobile-menu-drawer\\\" \\n          className=\\\"lg:hidden bg-[#FAF8F5] border-b border-[#EAE2D7] px-4 pt-3 pb-6 space-y-2 shadow-lg\\\"\\n        >\\n          <div className=\\\"grid gap-1\\\">\\n            {navLinks.map((link) => {\\n              const isActive = currentView === link.id;\\n              return (\\n                <button\\n                  key={link.id}\\n                  id={`mobile-nav-${link.id}`}\\n                  onClick={() => handleNavClick(link.id)}\\n                  className={`w-full text-left px-4 py-3 rounded-xl text-base font-medium flex items-center justify-between transition-colors ${\\n                    isActive \\n                      ? \'bg-[#F2EBE1] text-[#1C1917] font-semibold border-l-4 border-[#C5A059]\' \\n                      : \'text-[#4A453E] hover:bg-[#F7F3EE]\'\\n                  }`}\\n                >\\n                  <span>{link.label}</span>\\n                  {link.badge && (\\n                    <span className=\\\"bg-[#FAF0DE] text-[#8C6D37] border border-[#E8D4B0] text-xs px-2 py-0.5 rounded-full font-semibold\\\">\\n                      {link.badge}\\n                    </span>\\n                  )}\\n                </button>\\n              );\\n            })}\\n          </div>\\n\\n          <div className=\\\"pt-4 mt-2 border-t border-[#EAE2D7] flex flex-col gap-3\\\">\\n            <a\\n              id=\\\"mobile-whatsapp-direct\\\"\\n              href={BUSINESS_INFO.whatsappUrl}\\n              target=\\\"_blank\\\"\\n              rel=\\\"noopener noreferrer\\\"\\n              className=\\\"w-full py-3.5 px-4 bg-[#25D366] text-white font-semibold rounded-xl flex items-center justify-center gap-2 shadow-xs uppercase tracking-wider text-xs\\\"\\n            >\\n              <MessageCircle className=\\\"w-4 h-4 fill-white\\\" />\\n              <span>Chat / Order on WhatsApp</span>\\n            </a>\\n\\n            <a\\n              id=\\\"mobile-phone-call\\\"\\n              href={`tel:${BUSINESS_INFO.phoneRaw}`}\\n              className=\\\"w-full py-3 px-4 bg-white border border-[#D9CFC4] text-[#1C1917] font-medium rounded-xl flex items-center justify-center gap-2 text-xs\\\"\\n            >\\n              <Phone className=\\\"w-4 h-4 text-[#8C6D37]\\\" />\\n              <span>Call Store: {BUSINESS_INFO.phone}</span>\\n            </a>\\n          </div>\\n        </div>\\n      )}\\n    </header>\\n  );\\n};\", \"TargetContent\":\"import React, { useState } from \'react\';\\nimport { \\n  ShoppingBag, \\n  Menu, \\n  X, \\n  Phone, \\n  MessageCircle, \\n  Sparkles, \\n  Search,\\n  MapPin\\n} from \'lucide-react\';\\nimport { BUSINESS_INFO } from \'../data/products\';\\n\\ninterface NavbarProps {\\n  currentView: string;\\n  onNavigate: (view: string) => void;\\n  inquiryCount: number;\\n  onOpenInquiryDrawer: () => void;\\n  onOpenSearch: () => void;\\n}\\n\\nexport const Navbar: React.FC<NavbarProps> = ({\\n  currentView,\\n  onNavigate,\\n  inquiryCount,\\n  onOpenInquiryDrawer,\\n  onOpenSearch,\\n}) => {\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n\\n  interface NavLinkItem {\\n    id: string;\\n    label: string;\\n    badge?: string;\\n  }\\n\\n  const navLinks: NavLinkItem[] = [\\n    { id: \'shop\', label: \'Shop\' },\\n    { id: \'new-arrivals\', label: \'New Arrivals\', badge: \'New\' },\\n    { id: \'wholesale\', label: \'Wholesale\' },\\n    { id: \'about\', label: \'About\' },\\n    { id: \'contact\', label: \'Contact\' },\\n  ];\\n\\n  const handleNavClick = (id: string) => {\\n    onNavigate(id);\\n    setMobileMenuOpen(false);\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  return (\\n    <>\\n      {/* Top Notification Announcement Bar */}\\n      <div \\n        id=\\\"announcement-bar\\\" \\n        className=\\\"bg-[#1C1917] text-[#FAF8F5] text-xs py-2 px-4 border-b border-[#2C2825]\\\"\\n      >\\n        <div className=\\\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left\\\">\\n          <div className=\\\"flex items-center gap-2 justify-center\\\">\\n            <span className=\\\"inline-flex items-center justify-center bg-[#C5A059] text-[#1C1917] text-[10px] font-semibold px-2 py-0.5 rounded-full uppercase tracking-wider\\\">\\n              Ijebu Ode Store\\n            </span>\\n            <span className=\\\"text-[#E5DFD7] font-medium\\\">\\n              Washed, ironed & neatly packed thrift abayas \342\200\242 Delivering across Nigeria\\n            </span>\\n          </div>\\n\\n          <div className=\\\"hidden md:flex items-center gap-4 text-[#D5CEC4] text-xs\\\">\\n            <a \\n              href=\\\"tel:08112444087\\\" \\n              className=\\\"flex items-center gap-1.5 hover:text-[#C5A059] transition-colors\\\"\\n            >\\n              <Phone className=\\\"w-3.5 h-3.5 text-[#C5A059]\\\" />\\n              <span>0811 244 4087</span>\\n            </a>\\n            <span className=\\\"text-[#4A453E]\\\">\342\200\242</span>\\n            <div className=\\\"flex items-center gap-1.5 text-xs text-[#E5DFD7]\\\">\\n              <MapPin className=\\\"w-3.5 h-3.5 text-[#C5A059]\\\" />\\n              <span>Ibadan Garage Side, Ijebu Ode</span>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Main Header */}\\n      <header \\n        id=\\\"main-header\\\" \\n        className=\\\"sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-[#EAE2D7] shadow-xs\\\"\\n      >\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n          <div className=\\\"flex items-center justify-between h-20\\\">\\n            \\n            {/* Brand Logo */}\\n            <button\\n              id=\\\"brand-logo-btn\\\"\\n              onClick={() => handleNavClick(\'home\')}\\n              className=\\\"flex flex-col text-left group focus:outline-none\\\"\\n            >\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"font-serif text-2xl sm:text-3xl font-bold tracking-tight text-[#1C1917] group-hover:text-[#8C6D37] transition-colors\\\">\\n                  Pearls Elegance\\n                </span>\\n                <span className=\\\"w-2 h-2 rounded-full bg-[#C5A059] inline-block mb-1\\\"></span>\\n              </div>\\n              <span className=\\\"text-[10px] sm:text-xs uppercase tracking-[0.22em] text-[#6B655D] font-medium\\\">\\n                Thrift Abaya Wears\\n              </span>\\n            </button>\\n\\n            {/* Desktop Navigation */}\\n            <nav id=\\\"desktop-nav\\\" className=\\\"hidden lg:flex items-center gap-8\\\">\\n              {navLinks.map((link) => {\\n                const isActive = currentView === link.id;\\n                return (\\n                  <button\\n                    key={link.id}\\n                    id={`nav-link-${link.id}`}\\n                    onClick={() => handleNavClick(link.id)}\\n                    className={`relative text-sm font-medium transition-colors py-2 flex items-center gap-1.5 ${\\n                      isActive \\n                        ? \'text-[#1C1917] font-semibold\' \\n                        : \'text-[#5A544C] hover:text-[#1C1917]\'\\n                    }`}\\n                  >\\n                    <span>{link.label}</span>\\n                    {link.badge && (\\n                      <span className=\\\"bg-[#FAF0DE] text-[#8C6D37] border border-[#E8D4B0] text-[10px] px-1.5 py-0.2 rounded-full font-semibold\\\">\\n                        {link.badge}\\n                      </span>\\n                    )}\\n                    {isActive && (\\n                      <span className=\\\"absolute bottom-0 left-0 right-0 h-0.5 bg-[#C5A059] rounded-full\\\" />\\n                    )}\\n                  </button>\\n                );\\n              })}\\n            </nav>\\n\\n            {/* Actions: Search, Inquiry Bag, WhatsApp CTA */}\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <button\\n                id=\\\"search-trigger-btn\\\"\\n                onClick={onOpenSearch}\\n                aria-label=\\\"Search catalog\\\"\\n                className=\\\"p-2.5 rounded-full text-[#4A453E] hover:bg-[#F2EBE1] hover:text-[#1C1917] transition-colors\\\"\\n                title=\\\"Search collection\\\"\\n              >\\n                <Search className=\\\"w-5 h-5\\\" />\\n              </button>\\n\\n              <button\\n                id=\\\"inquiry-bag-btn\\\"\\n                onClick={onOpenInquiryDrawer}\\n                aria-label=\\\"View Inquiry List\\\"\\n                className=\\\"relative p-2.5 rounded-full text-[#4A453E] hover:bg-[#F2EBE1] hover:text-[#1C1917] transition-colors\\\"\\n                title=\\\"Inquiry List\\\"\\n              >\\n                <ShoppingBag className=\\\"w-5 h-5\\\" />\\n                {inquiryCount > 0 && (\\n                  <span className=\\\"absolute -top-0.5 -right-0.5 w-5 h-5 bg-[#C5A059] text-[#1C1917] text-[11px] font-bold rounded-full flex items-center justify-center border-2 border-[#FAF8F5]\\\">\\n                    {inquiryCount}\\n                  </span>\\n                )}\\n              </button>\\n\\n              <a\\n                id=\\\"whatsapp-header-cta\\\"\\n                href={BUSINESS_INFO.whatsappUrl}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"hidden sm:inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20BE5B] text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-xs transition-all hover:shadow-md\\\"\\n              >\\n                <MessageCircle className=\\\"w-4 h-4 fill-white\\\" />\\n                <span>WhatsApp</span>\\n              </a>\\n\\n              {/* Mobile Menu Toggle Button */}\\n              <button\\n                id=\\\"mobile-menu-toggle-btn\\\"\\n                onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\\n                aria-label=\\\"Toggle Navigation Menu\\\"\\n                className=\\\"lg:hidden p-2.5 rounded-lg text-[#1C1917] hover:bg-[#F2EBE1] transition-colors\\\"\\n              >\\n                {mobileMenuOpen ? <X className=\\\"w-6 h-6\\\" /> : <Menu className=\\\"w-6 h-6\\\" />}\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Mobile Navigation Drawer */}\\n        {mobileMenuOpen && (\\n          <div \\n            id=\\\"mobile-menu-drawer\\\" \\n            className=\\\"lg:hidden bg-[#FAF8F5] border-b border-[#EAE2D7] px-4 pt-3 pb-6 space-y-2 shadow-lg\\\"\\n          >\\n            <div className=\\\"grid gap-1\\\">\\n              {navLinks.map((link) => {\\n                const isActive = currentView === link.id;\\n                return (\\n                  <button\\n                    key={link.id}\\n                    id={`mobile-nav-${link.id}`}\\n                    onClick={() => handleNavClick(link.id)}\\n                    className={`w-full text-left px-4 py-3 rounded-xl text-base font-medium flex items-center justify-between transition-colors ${\\n                      isActive \\n                        ? \'bg-[#F2EBE1] text-[#1C1917] font-semibold border-l-4 border-[#C5A059]\' \\n                        : \'text-[#4A453E] hover:bg-[#F7F3EE]\'\\n                    }`}\\n                  >\\n                    <span>{link.label}</span>\\n                    {link.badge && (\\n                      <span className=\\\"bg-[#FAF0DE] text-[#8C6D37] border border-[#E8D4B0] text-xs px-2 py-0.5 rounded-full font-semibold\\\">\\n                        {link.badge}\\n                      </span>\\n                    )}\\n                  </button>\\n                );\\n              })}\\n            </div>\\n\\n            <div className=\\\"pt-4 mt-2 border-t border-[#EAE2D7] flex flex-col gap-3\\\">\\n              <a\\n                id=\\\"mobile-whatsapp-direct\\\"\\n                href={BUSINESS_INFO.whatsappUrl}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"w-full py-3.5 px-4 bg-[#25D366] text-white font-semibold rounded-xl flex items-center justify-center gap-2 shadow-xs\\\"\\n              >\\n                <MessageCircle className=\\\"w-4 h-4 fill-white\\\" />\\n                <span>Chat / Order on WhatsApp</span>\\n              </a>\\n\\n              <a\\n                id=\\\"mobile-phone-call\\\"\\n                href={`tel:${BUSINESS_INFO.phoneRaw}`}\\n                className=\\\"w-full py-3 px-4 bg-[#FAF8F5] border border-[#D9CFC4] text-[#1C1917] font-medium rounded-xl flex items-center justify-center gap-2\\\"\\n              >\\n                <Phone className=\\\"w-4 h-4 text-[#8C6D37]\\\" />\\n                <span>Call Store: {BUSINESS_INFO.phone}</span>\\n              </a>\\n            </div>\\n          </div>\\n        )}\\n      </header>\\n    </>\\n  );\\n};\", \"TargetFile\":\"/src/components/Navbar.tsx\", \"toolAction\":\"Removing announcement bar and refining header\", \"toolSummary\":\"Refine Navbar.tsx\"}"
