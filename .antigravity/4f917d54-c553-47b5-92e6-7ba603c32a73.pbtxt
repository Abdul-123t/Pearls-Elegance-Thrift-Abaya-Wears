      replacement_content: "import { Product } from \'../types\';\n\n// Real product catalog based on Pearls Elegance Thrift Abaya Wears pricing & offerings\nexport const PRODUCTS: Product[] = [\n  {\n    id: \'thrift-abaya-wear-01\',\n    name: \'Thrift Abaya Wears\',\n    category: \'Abayas\',\n    subCategory: \'Classic Abaya\',\n    price: 9000,\n    priceFormatted: \'\342\202\2469,000\',\n    image: \'/src/assets/images/product_abaya_wear_1789895070761.jpg\',\n    gallery: [\n      \'/src/assets/images/product_abaya_wear_1789895070761.jpg\',\n      \'/src/assets/images/hero_abaya_banner_1789895058317.jpg\'\n    ],\n    isPopular: true,\n    isNewArrival: false,\n    availability: \'In Stock\',\n    condition: \'Handpicked Grade-A Thrift (Freshly washed, ironed & neatly packaged)\',\n    sizes: [\'Free Size (Fits 52 - 58)\'],\n    colors: [\'Classic Black\', \'Charcoal & Gold trim\', \'Midnight Navy\'],\n    description: \'Carefully curated quality thrift abaya with tasteful embroidery details. Flowing modest silhouette suitable for daily wear, Friday prayers, and special events. Pre-washed and ironed ready to wear.\',\n    features: [\n      \'Grade-A carefully selected thrift quality\',\n      \'Breathable, modest drape fabric\',\n      \'Washed, steam-ironed & individually packed\',\n      \'Retail & wholesale bundles available\'\n    ],\n    wholesaleAvailable: true,\n  },\n  {\n    id: \'new-arrival-abaya-02\',\n    name: \'New Arrival Abayas\',\n    category: \'Abayas\',\n    subCategory: \'Premium Modest Wear\',\n    price: 12000,\n    priceFormatted: \'\342\202\24612,000\',\n    image: \'/src/assets/images/hero_abaya_banner_1789895058317.jpg\',\n    gallery: [\n      \'/src/assets/images/hero_abaya_banner_1789895058317.jpg\',\n      \'/src/assets/images/product_abaya_wear_1789895070761.jpg\'\n    ],\n    isNewArrival: true,\n    isPopular: true,\n    availability: \'In Stock\',\n    condition: \'Premium Select / Fresh Shipment\',\n    sizes: [\'54\', \'56\', \'58\'],\n    colors: [\'Deep Jet Black\', \'Champagne Beige\', \'Rich Chocolate\'],\n    description: \'Fresh batch of new arrival modest abayas featuring modern cuts, delicate sleeve detailing, and elegant drape. High quality fabric offering timeless modesty and sophistication.\',\n    features: [\n      \'Freshly added collection piece\',\n      \'Detailed sleeve & neckline accents\',\n      \'Flattering modest fit\',\n      \'Available for individual order and wholesale packs\'\n    ],\n    wholesaleAvailable: true,\n  },\n  {\n    id: \'thrift-kinomo-abaya-03\',\n    name: \'Thrift Kinomo Abaya with New Inner Dress\',\n    category: \'Kinomo\',\n    subCategory: \'Kimono & Inner Set\',\n    price: 12500,\n    priceFormatted: \'\342\202\24612,500\',\n    priceNote: \'Range \342\202\24610,000 \342\200\223 \342\202\24615,000 depending on style\',\n    image: \'/src/assets/images/product_kinomo_abaya_1789895096940.jpg\',\n    gallery: [\n      \'/src/assets/images/product_kinomo_abaya_1789895096940.jpg\',\n      \'/src/assets/images/hero_abaya_banner_1789895058317.jpg\'\n    ],\n    isNewArrival: true,\n    isPopular: true,\n    availability: \'Few Pieces Left\',\n    condition: \'Thrift Kimono Layer + Brand New Coordinating Inner Dress\',\n    sizes: [\'M\', \'L\', \'XL\', \'Free Size\'],\n    colors: [\'Mocha Brown Set\', \'Taupe Earth Set\', \'Classic Noir Set\'],\n    description: \'A stylish 2-piece combination featuring an open-front flowing thrift kinomo (kimono) jacket paired with a brand new matching sleeveless inner gown. Offers maximum versatility and modest flair.\',\n    features: [\n      \'Includes open outer kinomo + inner gown\',\n      \'Can be styled together or worn separately\',\n      \'Neatly packaged and ready to wear\',\n      \'High demand reseller favorite\'\n    ],\n    wholesaleAvailable: true,\n  },\n  {\n    id: \'new-arrival-adult-jalabia-04\',\n    name: \'New Arrival Adult Jalabias\',\n    category: \'Jalabiyas\',\n    subCategory: \'Adult Modest Jalabia\',\n    price: 6000,\n    priceFormatted: \'\342\202\2466,000\',\n    image: \'/src/assets/images/product_jalabia_1789895085426.jpg\',\n    gallery: [\n      \'/src/assets/images/product_jalabia_1789895085426.jpg\'\n    ],\n    isNewArrival: true,\n    isPopular: false,\n    availability: \'In Stock\',\n    condition: \'Quality Select Modest Wear\',\n    sizes: [\'M (54)\', \'L (56)\', \'XL (58)\', \'XXL (60)\'],\n    colors: [\'Emerald Green\', \'Royal Navy\', \'Sand Stone\', \'Pure White\'],\n    description: \'Comfortable and lightweight adult jalabias designed for ease, prayer, and relaxation. Features clean collar designs with subtle geometric or gold embroidery stitching.\',\n    features: [\n      \'Comfortable lightweight cotton-blend fabric\',\n      \'Modest cut suitable for women and men\',\n      \'Great for indoor relaxation and prayer\',\n      \'Wholesale bundles available for retailers\'\n    ],\n    wholesaleAvailable: true,\n  },\n  {\n    id: \'kiddies-abaya-jalabia-05\',\n    name: \'Kiddies Abaya and Jalabia\',\n    category: \'Kiddies Wear\',\n    subCategory: \'Children Modest Wear\',\n    price: 6000,\n    priceFormatted: \'\342\202\2466,000\',\n    image: \'/src/assets/images/product_kiddies_abaya_1789895109370.jpg\',\n    gallery: [\n      \'/src/assets/images/product_kiddies_abaya_1789895109370.jpg\'\n    ],\n    isNewArrival: false,\n    isPopular: true,\n    availability: \'In Stock\',\n    condition: \'Clean, gently used thrift & new select for kids\',\n    sizes: [\'Ages 3-5\', \'Ages 6-8\', \'Ages 9-12\'],\n    colors: [\'Soft Lilac\', \'Pastel Pink\', \'Cream & Gold\', \'Sky Blue\'],\n    description: \'Charming and modest abayas and jalabiyas tailored for children and young girls/boys. Breathable, durable, and comfortable with gentle embroidery.\',\n    features: [\n      \'Gentle on sensitive skin\',\n      \'Easy wash & wear durability\',\n      \'Appropriate lengths for active children\',\n      \'Affordable modest wear for families\'\n    ],\n    wholesaleAvailable: true,\n  },\n  {\n    id: \'thrift-tops-gowns-06\',\n    name: \'Thrift Tops and Gowns\',\n    category: \'Thrift Tops & Gowns\',\n    subCategory: \'Modest Tops & Maxi Gowns\',\n    price: 2000,\n    priceFormatted: \'\342\202\2462,000\',\n    image: \'/src/assets/images/product_thrift_gown_1789895120024.jpg\',\n    gallery: [\n      \'/src/assets/images/product_thrift_gown_1789895120024.jpg\'\n    ],\n    isNewArrival: false,\n    isPopular: true,\n    availability: \'In Stock\',\n    condition: \'Grade-A Thrift Tops & Gowns (Washed and Pressed)\',\n    sizes: [\'S\', \'M\', \'L\', \'XL\'],\n    colors: [\'Caramel Earth\', \'Floral Modest Prints\', \'Solid Neutrals\'],\n    description: \'Budget-friendly thrift tops, tunics, and modest maxi gowns starting from just \342\202\2462,000. Each piece is hand-selected, cleaned, and ready to style.\',\n    features: [\n      \'Unbeatable budget price of \342\202\2462,000\',\n      \'Washed and ironed before dispatch\',\n      \'Ideal for everyday wear and casual layering\',\n      \'High volume reseller discount available\'\n    ],\n    wholesaleAvailable: true,\n  }\n];\n\nexport const CATEGORIES: { name: string; description: string; count: number }[] = [\n  { name: \'All\', description: \'Explore full catalog of affordable modest wear\', count: PRODUCTS.length },\n  { name: \'Abayas\', description: \'Classic and modern modest abayas from \342\202\2469,000\', count: 2 },\n  { name: \'Jalabiyas\', description: \'Comfortable adult jalabias for prayer & leisure\', count: 1 },\n  { name: \'Kinomo\', description: \'2-piece open kimono with matching inner dress\', count: 1 },\n  { name: \'Kiddies Wear\', description: \'Modest abayas and jalabiyas for kids from \342\202\2466,000\', count: 1 },\n  { name: \'Thrift Tops & Gowns\', description: \'Quality thrift tops and gowns from just \342\202\2462,000\', count: 1 },\n  { name: \'New Arrivals\', description: \'Freshly added items & newest shipment pieces\', count: 3 },\n  { name: \'Wholesale / Bulk\', description: \'Bale and bulk packages for resellers & boutique owners\', count: PRODUCTS.length }\n];\n\nexport const BUSINESS_INFO = {\n  name: \'Pearls Elegance Thrift Abaya Wears\',\n  tagline: \'Affordable elegance meets modest fashion\',\n  address: \'Ibadan Garage Side, Ijebu Ode, 120101, Ogun State, Nigeria\',\n  shortLocation: \'Ibadan Garage Side, Ijebu Ode, Ogun State\',\n  phone: \'0811 244 4087\',\n  phoneRaw: \'08112444087\',\n  phoneIntl: \'+2348112444087\',\n  whatsappRaw: \'2348112444087\',\n  whatsappUrl: \'https://wa.me/2348112444087\',\n  googleRating: 5.0,\n  reviewCount: 1,\n  deliveryNote: \'Delivering to Ijebu Ode, Abeokuta, Lagos, Ibadan and across all 36 States in Nigeria\',\n  openingHours: \'Monday \342\200\223 Saturday: 8:00 AM \342\200\223 7:00 PM\',\n};\n"
