    replacement_chunks {
      target_content: "import React from \'react\';\nimport { \n  X, \n  Trash2, \n  Plus, \n  Minus, \n  MessageCircle, \n  ShoppingBag, \n  ArrowRight,\n  ShieldCheck,\n  Package\n} from \'lucide-react\';\nimport { InquiryItem } from \'../types\';\nimport { getCombinedInquiryWhatsAppUrl } from \'../utils/whatsapp\';\n\ninterface InquiryDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  items: InquiryItem[];\n  onUpdateQuantity: (productId: string, delta: number) => void;\n  onRemoveItem: (productId: string) => void;\n  onClearAll: () => void;\n  onNavigateToShop: () => void;\n}\n\nexport const InquiryDrawer: React.FC<InquiryDrawerProps> = ({\n  isOpen,\n  onClose,\n  items,\n  onUpdateQuantity,\n  onRemoveItem,\n  onClearAll,\n  onNavigateToShop,\n}) => {\n  if (!isOpen) return null;\n\n  const totalEstimatedPrice = items.reduce(\n    (sum, item) => sum + (item.product.price * item.quantity), \n    0\n  );\n\n  const totalQuantity = items.reduce((sum, item) => sum + item.quantity, 0);\n\n  const whatsappUrl = getCombinedInquiryWhatsAppUrl(items);\n\n  return (\n    <div \n      id=\"inquiry-drawer-overlay\"\n      className=\"fixed inset-0 z-50 overflow-hidden bg-black/60 backdrop-blur-xs flex justify-end\"\n    >\n      <div \n        id=\"inquiry-drawer-content\"\n        className=\"w-full max-w-md bg-[#FAF8F5] h-full shadow-2xl flex flex-col border-l border-[#EAE2D7] relative animate-in slide-in-from-right duration-300\"\n      >\n        {/* Header */}\n        <div className=\"p-5 sm:p-6 border-b border-[#EAE2D7] bg-white flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-full bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center font-bold\">\n              <ShoppingBag className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-serif text-xl font-bold text-[#1C1917]\">\n                Inquiry Bag\n              </h3>\n              <p className=\"text-xs text-[#6B655D]\">\n                {items.length === 0 \n                  ? \'No items added yet\' \n                  : `${totalQuantity} ${totalQuantity === 1 ? \'item\' : \'items\'} ready to inquire`}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {items.length > 0 && (\n              <button\n                id=\"clear-inquiry-btn\"\n                onClick={onClearAll}\n                className=\"text-xs text-[#8A847C] hover:text-[#C62828] transition-colors p-1\"\n                title=\"Clear all items\"\n              >\n                Clear\n              </button>\n            )}\n            <button\n              id=\"close-inquiry-drawer-btn\"\n              onClick={onClose}\n              aria-label=\"Close drawer\"\n              className=\"p-2 rounded-full text-[#6B655D] hover:bg-[#FAF8F5] transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Content list */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-4\">\n          {items.length === 0 ? (\n            <div className=\"h-full flex flex-col items-center justify-center text-center p-6 space-y-4\">\n              <div className=\"w-16 h-16 rounded-full bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center\">\n                <ShoppingBag className=\"w-8 h-8 opacity-60\" />\n              </div>\n              <h4 className=\"font-serif text-xl font-bold text-[#1C1917]\">\n                Your Inquiry Bag is Empty\n              </h4>\n              <p className=\"text-xs text-[#5A544C] max-w-xs leading-relaxed\">\n                Add pieces from our thrift collection to inquire about availability and pricing together in a single WhatsApp message.\n              </p>\n              <button\n                id=\"drawer-browse-catalog-btn\"\n                onClick={() => {\n                  onClose();\n                  onNavigateToShop();\n                }}\n                className=\"inline-flex items-center gap-2 bg-[#1C1917] hover:bg-[#8C6D37] text-white text-xs font-semibold px-6 py-3 rounded-full transition-colors\"\n              >\n                <span>Browse Catalog</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          ) : (\n            <>\n              <div className=\"bg-[#F5EFE6] p-3 rounded-xl border border-[#E8DDCB] text-xs text-[#5A544C] flex items-start gap-2\">\n                <ShieldCheck className=\"w-4 h-4 text-[#8C6D37] shrink-0 mt-0.5\" />\n                <span>We confirm item availability and send real-time pictures on WhatsApp before dispatch.</span>\n              </div>\n\n              <div className=\"space-y-3\">\n                {items.map((item) => (\n                  <div \n                    key={item.product.id}\n                    id={`inquiry-item-${item.product.id}`}\n                    className=\"p-3.5 bg-white rounded-2xl border border-[#EAE2D7] shadow-2xs flex gap-3.5 items-center\"\n                  >\n                    <img \n                      src={item.product.image} \n                      alt={item.product.name} \n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-16 h-20 rounded-xl object-cover bg-[#F5EFE6] border border-[#EAE2D7] shrink-0\"\n                    />\n\n                    <div className=\"flex-1 min-w-0\">\n                      <h5 className=\"font-serif font-bold text-[#1C1917] text-sm truncate\">\n                        {item.product.name}\n                      </h5>\n                      <div className=\"text-xs font-serif font-bold text-[#1C1917] mt-0.5\">\n                        {item.product.priceFormatted}\n                      </div>\n                      \n                      {(item.selectedSize || item.selectedColor) && (\n                        <div className=\"text-[11px] text-[#6B655D] mt-0.5 truncate\">\n                          {item.selectedSize && `Size: ${item.selectedSize}`}\n                          {item.selectedSize && item.selectedColor && \' \342\200\242 \'}\n                          {item.selectedColor && `Color: ${item.selectedColor}`}\n                        </div>\n                      )}\n\n                      {/* Quantity selector */}\n                      <div className=\"flex items-center justify-between mt-2 pt-1 border-t border-[#F2EBE1]\">\n                        <div className=\"flex items-center border border-[#D9CFC4] rounded-lg bg-[#FAF8F5]\">\n                          <button\n                            onClick={() => onUpdateQuantity(item.product.id, -1)}\n                            className=\"p-1 hover:bg-[#EAE2D7] text-[#1C1917] rounded-l-lg transition-colors\"\n                            title=\"Decrease quantity\"\n                          >\n                            <Minus className=\"w-3.5 h-3.5\" />\n                          </button>\n                          <span className=\"px-2.5 text-xs font-semibold text-[#1C1917]\">\n                            {item.quantity}\n                          </span>\n                          <button\n                            onClick={() => onUpdateQuantity(item.product.id, 1)}\n                            className=\"p-1 hover:bg-[#EAE2D7] text-[#1C1917] rounded-r-lg transition-colors\"\n                            title=\"Increase quantity\"\n                          >\n                            <Plus className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n\n                        <button\n                          onClick={() => onRemoveItem(item.product.id)}\n                          className=\"text-[#8A847C] hover:text-[#C62828] p-1 transition-colors\"\n                          title=\"Remove item\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </>\n          )}\n        </div>\n\n        {/* Footer actions */}\n        {items.length > 0 && (\n          <div className=\"p-5 sm:p-6 bg-white border-t border-[#EAE2D7] space-y-4\">\n            \n            {/* Price estimate */}\n            <div className=\"flex items-center justify-between text-sm\">\n              <span className=\"text-[#6B655D]\">Estimated Total:</span>\n              <span className=\"font-serif font-bold text-xl text-[#1C1917]\">\n                \342\202\246{totalEstimatedPrice.toLocaleString()}\n              </span>\n            </div>\n\n            <p className=\"text-[11px] text-[#8A847C] text-center\">\n              Clicking below sends your selected items directly to our sales desk on WhatsApp.\n            </p>\n\n            {/* Send WhatsApp order button */}\n            <a\n              id=\"send-full-inquiry-whatsapp-btn\"\n              href={whatsappUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all text-sm tracking-wide text-center\"\n            >\n              <MessageCircle className=\"w-5 h-5 fill-white shrink-0\" />\n              <span>SEND INQUIRY ON WHATSAPP</span>\n            </a>\n\n            <button\n              onClick={onClose}\n              className=\"w-full py-2 text-xs text-[#5A544C] hover:text-[#1C1917] font-semibold text-center\"\n            >\n              Continue Browsing\n            </button>\n\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useEffect } from \'react\';\nimport { \n  X, \n  Trash2, \n  Plus, \n  Minus, \n  MessageCircle, \n  ShoppingBag, \n  ArrowRight,\n  ShieldCheck,\n  Package\n} from \'lucide-react\';\nimport { InquiryItem } from \'../types\';\nimport { getCombinedInquiryWhatsAppUrl } from \'../utils/whatsapp\';\n\ninterface InquiryDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  items: InquiryItem[];\n  onUpdateQuantity: (productId: string, delta: number) => void;\n  onRemoveItem: (productId: string) => void;\n  onClearAll: () => void;\n  onNavigateToShop: () => void;\n}\n\nexport const InquiryDrawer: React.FC<InquiryDrawerProps> = ({\n  isOpen,\n  onClose,\n  items,\n  onUpdateQuantity,\n  onRemoveItem,\n  onClearAll,\n  onNavigateToShop,\n}) => {\n  // Lock body scroll and handle Escape key\n  useEffect(() => {\n    if (!isOpen) return;\n\n    const originalOverflow = document.body.style.overflow;\n    document.body.style.overflow = \'hidden\';\n\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') {\n        onClose();\n      }\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => {\n      document.body.style.overflow = originalOverflow;\n      window.removeEventListener(\'keydown\', handleKeyDown);\n    };\n  }, [isOpen, onClose]);\n\n  if (!isOpen) return null;\n\n  const totalEstimatedPrice = items.reduce(\n    (sum, item) => sum + (item.product.price * item.quantity), \n    0\n  );\n\n  const totalQuantity = items.reduce((sum, item) => sum + item.quantity, 0);\n\n  const whatsappUrl = getCombinedInquiryWhatsAppUrl(items);\n\n  return (\n    <div \n      id=\"inquiry-drawer-overlay\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Your Order Inquiry List\"\n      onClick={onClose}\n      className=\"fixed inset-0 z-50 overflow-hidden bg-black/60 backdrop-blur-xs flex justify-end\"\n    >\n      <div \n        id=\"inquiry-drawer-content\"\n        onClick={(e) => e.stopPropagation()}\n        className=\"w-full max-w-md bg-[#FAF8F5] h-full shadow-2xl flex flex-col border-l border-[#EAE2D7] relative animate-in slide-in-from-right duration-300\"\n      >\n        {/* Header */}\n        <div className=\"p-5 sm:p-6 border-b border-[#EAE2D7] bg-white flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-full bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center font-bold\">\n              <ShoppingBag className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"font-serif text-xl font-bold text-[#1C1917]\">\n                Inquiry Bag\n              </h3>\n              <p className=\"text-xs text-[#6B655D]\">\n                {items.length === 0 \n                  ? \'No items added yet\' \n                  : `${totalQuantity} ${totalQuantity === 1 ? \'item\' : \'items\'} ready to inquire`}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {items.length > 0 && (\n              <button\n                id=\"clear-inquiry-btn\"\n                onClick={onClearAll}\n                className=\"text-xs text-[#8A847C] hover:text-[#C62828] transition-colors p-1\"\n                title=\"Clear all items\"\n              >\n                Clear\n              </button>\n            )}\n            <button\n              id=\"close-inquiry-drawer-btn\"\n              onClick={onClose}\n              aria-label=\"Close Inquiry Drawer\"\n              className=\"p-2 rounded-full text-[#6B655D] hover:bg-[#FAF8F5] transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Content list */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-4\">\n          {items.length === 0 ? (\n            <div className=\"h-full flex flex-col items-center justify-center text-center p-6 space-y-4\">\n              <div className=\"w-16 h-16 rounded-full bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center\">\n                <ShoppingBag className=\"w-8 h-8 opacity-60\" />\n              </div>\n              <h4 className=\"font-serif text-xl font-bold text-[#1C1917]\">\n                Your Inquiry Bag is Empty\n              </h4>\n              <p className=\"text-xs text-[#5A544C] max-w-xs leading-relaxed\">\n                Add pieces from our thrift collection to inquire about availability and pricing together in a single WhatsApp message.\n              </p>\n              <button\n                id=\"drawer-browse-catalog-btn\"\n                onClick={() => {\n                  onClose();\n                  onNavigateToShop();\n                }}\n                className=\"inline-flex items-center gap-2 bg-[#1C1917] hover:bg-[#8C6D37] text-white text-xs font-semibold px-6 py-3 rounded-full transition-colors uppercase tracking-wider\"\n              >\n                <span>Browse Catalog</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          ) : (\n            <>\n              <div className=\"bg-[#F5EFE6] p-3 rounded-xl border border-[#E8DDCB] text-xs text-[#5A544C] flex items-start gap-2\">\n                <ShieldCheck className=\"w-4 h-4 text-[#8C6D37] shrink-0 mt-0.5\" />\n                <span>We confirm item availability and send real-time pictures on WhatsApp before dispatch.</span>\n              </div>\n\n              <div className=\"space-y-3\">\n                {items.map((item) => (\n                  <div \n                    key={item.product.id}\n                    id={`inquiry-item-${item.product.id}`}\n                    className=\"p-3.5 bg-white rounded-2xl border border-[#EAE2D7] shadow-2xs flex gap-3.5 items-center\"\n                  >\n                    <img \n                      src={item.product.image} \n                      alt={item.product.name} \n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-16 h-20 rounded-xl object-cover bg-[#F5EFE6] border border-[#EAE2D7] shrink-0\"\n                    />\n\n                    <div className=\"flex-1 min-w-0\">\n                      <h5 className=\"font-serif font-bold text-[#1C1917] text-sm truncate\">\n                        {item.product.name}\n                      </h5>\n                      <div className=\"text-xs font-serif font-bold text-[#1C1917] mt-0.5\">\n                        {item.product.priceFormatted}\n                      </div>\n                      \n                      {(item.selectedSize || item.selectedColor) && (\n                        <div className=\"text-[11px] text-[#6B655D] mt-0.5 truncate\">\n                          {item.selectedSize && `Size: ${item.selectedSize}`}\n                          {item.selectedSize && item.selectedColor && \' \342\200\242 \'}\n                          {item.selectedColor && `Color: ${item.selectedColor}`}\n                        </div>\n                      )}\n\n                      {/* Quantity selector */}\n                      <div className=\"flex items-center justify-between mt-2 pt-1 border-t border-[#F2EBE1]\">\n                        <div className=\"flex items-center border border-[#D9CFC4] rounded-lg bg-[#FAF8F5]\">\n                          <button\n                            onClick={() => onUpdateQuantity(item.product.id, -1)}\n                            className=\"p-1 hover:bg-[#EAE2D7] text-[#1C1917] rounded-l-lg transition-colors\"\n                            title=\"Decrease quantity\"\n                          >\n                            <Minus className=\"w-3.5 h-3.5\" />\n                          </button>\n                          <span className=\"px-2.5 text-xs font-semibold text-[#1C1917]\">\n                            {item.quantity}\n                          </span>\n                          <button\n                            onClick={() => onUpdateQuantity(item.product.id, 1)}\n                            className=\"p-1 hover:bg-[#EAE2D7] text-[#1C1917] rounded-r-lg transition-colors\"\n                            title=\"Increase quantity\"\n                          >\n                            <Plus className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n\n                        <button\n                          onClick={() => onRemoveItem(item.product.id)}\n                          className=\"text-[#8A847C] hover:text-[#C62828] p-1 transition-colors\"\n                          title=\"Remove item\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </>\n          )}\n        </div>\n\n        {/* Footer actions */}\n        {items.length > 0 && (\n          <div className=\"p-5 sm:p-6 bg-white border-t border-[#EAE2D7] space-y-4\">\n            \n            {/* Price estimate */}\n            <div className=\"flex items-center justify-between text-sm\">\n              <span className=\"text-[#6B655D]\">Estimated Total:</span>\n              <span className=\"font-serif font-bold text-xl text-[#1C1917]\">\n                \342\202\246{totalEstimatedPrice.toLocaleString()}\n              </span>\n            </div>\n\n            <p className=\"text-[11px] text-[#8A847C] text-center\">\n              Clicking below sends your selected items directly to our sales desk on WhatsApp.\n            </p>\n\n            {/* Send WhatsApp order button */}\n            <a\n              id=\"send-full-inquiry-whatsapp-btn\"\n              href={whatsappUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all text-xs sm:text-sm tracking-wider uppercase text-center\"\n            >\n              <MessageCircle className=\"w-5 h-5 fill-white shrink-0\" />\n              <span>Send Inquiry on WhatsApp</span>\n            </a>\n\n            <button\n              onClick={onClose}\n              className=\"w-full py-2.5 text-xs text-[#5A544C] hover:text-[#1C1917] font-semibold text-center\"\n            >\n              Continue Browsing\n            </button>\n\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};"
    }
    instruction: "Add keyboard escape listener, body scroll locking, and accessible ARIA attributes to InquiryDrawer"
  }
}
