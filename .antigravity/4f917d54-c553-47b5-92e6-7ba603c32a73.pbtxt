E]\">\n                        <Check className=\"w-3.5 h-3.5 text-[#8C6D37] shrink-0 mt-0.5\" />\n                        <span>{feat}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              )}\n            </div>\n\n            {/* Action Bar */}\n            <div className=\"pt-4 border-t border-[#EAE2D7] space-y-3\">\n              \n              {/* Primary WhatsApp Order Button with exact text */}\n              <a\n                id=\"modal-order-whatsapp-btn\"\n                href={whatsappUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"w-full py-4 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl flex items-center justify-center gap-2.5 shadow-md hover:shadow-lg transition-all text-sm sm:text-base text-center\"\n              >\n                <MessageCircle className=\"w-5 h-5 fill-white shrink-0\" />\n                <span>Order on WhatsApp \342\200\242 Instant Inquiry</span>\n              </a>\n\n              <div className=\"grid grid-cols-2 gap-2\">\n                {onToggleInquiryList && (\n                  <button\n                    id=\"modal-add-inquiry-btn\"\n                    onClick={() => onToggleInquiryList(product)}\n                    className={`w-full py-2.5 px-3 rounded-xl border text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors ${\n                      isInInquiryList \n                        ? \'bg-[#EAE2D7] border-[#C5B7A5] text-[#1C1917]\' \n                        : \'bg-white border-[#D9CFC4] text-[#1C1917] hover:bg-[#F5EFE6]\'\n                    }`}\n                  >\n                    {isInInquiryList ? (\n                      <>\n                        <Check className=\"w-3.5 h-3.5 text-[#2E7D32]\" />\n                        <span>In Inquiry List</span>\n                      </>\n                    ) : (\n          