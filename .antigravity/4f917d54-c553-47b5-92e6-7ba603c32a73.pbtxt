    content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Pearls Elegance Thrift Abaya Wears | Affordable Modest Fashion in Ijebu Ode, Nigeria</title>\n    <meta\n      name=\"description\"\n      content=\"Discover affordable thrift abayas, jalabiyas, dresses, and modest wear in Ijebu Ode, Ogun State. Washed, ironed, neatly packed thrift pieces. Wholesale & nationwide delivery.\"\n    />\n    <meta\n      name=\"keywords\"\n      content=\"Abaya in Ijebu Ode, Thrift Abaya Ijebu Ode, Jalabiya in Ogun State, Modest wear Nigeria, Affordable Abaya Nigeria, Thrift fashion Ijebu Ode, Abaya and Jalabia Nigeria, Wholesale Abaya Nigeria\"\n    />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:title\" content=\"Pearls Elegance Thrift Abaya Wears | Modest Fashion Ijebu Ode\" />\n    <meta\n      property=\"og:description\"\n      content=\"Affordable thrift abayas, jalabiyas, dresses & modest wear. Located at Ibadan Garage Side, Ijebu Ode. Delivering across Nigeria.\"\n    />\n    <meta property=\"og:site_name\" content=\"Pearls Elegance Thrift Abaya Wears\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Pearls Elegance Thrift Abaya Wears\" />\n    <meta\n      name=\"twitter:description\"\n      content=\"Affordable elegance meets modest fashion. Thrift abayas, jalabiyas & modest wears in Ijebu Ode, Nigeria.\"\n    />\n\n    <!-- Google Fonts for refined fashion typography -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\"\n      rel=\"stylesheet\"\n    />\n\n    <!-- LocalBusiness & ClothingStore Structured Data -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"ClothingStore\",\n      \"name\": \"Pearls Elegance Thrift Abaya Wears\",\n      \"image\": \"/src/assets/images/hero_editorial_mannequin_1789896317613.jpg\",\n      \"telephone\": \"+2348112444087\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"Ibadan Garage Side\",\n        \"addressLocality\": \"Ijebu Ode\",\n        \"addressRegion\": \"Ogun State\",\n        \"postalCode\": \"120101\",\n        \"addressCountry\": \"NG\"\n      },\n      \"priceRange\": \"\342\202\2462,000 - \342\202\24615,000\",\n      \"description\": \"Specializing in affordable thrift abayas, jalabiyas, and modest fashion for women and men in Ijebu Ode, Ogun State, delivering across Nigeria.\"\n    }\n    </script>\n  </head>\n  <body class=\"bg-[#FAF8F5] text-[#22201D] font-sans antialiased selection:bg-[#E8DDCB] selection:text-[#1A1816]\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n"
    raw_content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Pearls Elegance Thrift Abaya Wears | Affordable Modest Fashion in Ijebu Ode, Nigeria</title>\n    <meta\n      name=\"description\"\n      content=\"Discover affordable thrift abayas, jalabiyas, dresses, and modest wear in Ijebu Ode, Ogun State. Washed, ironed, neatly packed thrift pieces. Wholesale & nationwide delivery.\"\n    />\n    <meta\n      name=\"keywords\"\n      content=\"Abaya in Ijebu Ode, Thrift Abaya Ijebu Ode, Jalabiya in Ogun State, Modest wear Nigeria, Affordable Abaya Nigeria, Thrift fashion Ijebu Ode, Abaya and Jalabia Nigeria, Wholesale Abaya Nigeria\"\n    />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:title\" content=\"Pearls Elegance Thrift Abaya Wears | Modest Fashion Ijebu Ode\" />\n    <meta\n      property=\"og:description\"\n      content=\"Affordable thrift abayas, jalabiyas, dresses & modest wear. Located at Ibadan Garage Side, Ijebu Ode. Delivering across Nigeria.\"\n    />\n    <meta property=\"og:site_name\" content=\"Pearls Elegance Thrift Abaya Wears\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Pearls Elegance Thrift Abaya Wears\" />\n    <meta\n      name=\"twitter:description\"\n      content=\"Affordable elegance meets modest fashion. Thrift abayas, jalabiyas & modest wears in Ijebu Ode, Nigeria.\"\n    />\n\n    <!-- Google Fonts for refined fashion typography -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\"\n      rel=\"stylesheet\"\n    />\n