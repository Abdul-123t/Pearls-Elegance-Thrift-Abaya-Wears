          text: "                We believe in genuine customer service. Every item is washed, ironed, and ready to wear. Contact us anytime for photos or video clips of exact pieces on WhatsApp."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              </p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </section>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Update HomeView.tsx to match exact hero headline, CTAs, layout structure with New Arrivals section near the top, and remove unverified claims"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { \n  ArrowRight, \n  MessageCircle, \n  Sparkles, \n  ShieldCheck, \n  Sparkle, \n  ShoppingBag, \n  Truck, \n  Clock, \n  MapPin, \n  CheckCircle2, \n  Layers, \n  Store, \n  PackageCheck,\n  Percent\n} from \'lucide-react\';\nimport { Product, ProductCategory } from \'../types\';\nimport { ProductCard } from \'../components/ProductCard\';\nimport { TrustRatingBadge } from \'../components/TrustRatingBadge\';\nimport { BUSINESS_INFO, CATEGORIES } from \'../data/products\';\n\ninterface HomeViewProps {\n  products: Product[];\n  onSelectProduct: (product: Product) => void;\n  onNavigate: (view: string) => void;\n  onSelectCategory: (category: ProductCategory) => void;\n  inquiryListIds: string[];\n  onToggleInquiryList: (product: Product) => void;\n}\n\nexport const HomeView: React.FC<HomeViewProps> = ({\n  products,\n  onSelectProduct,\n  onNavigate,\n  onSelectCategory,\n  inquiryListIds,\n  onToggleInquiryList,\n}) => {\n  const newArrivals = products.filter((p) => p.isNewArrival);\n  const featuredProducts = products.slice(0, 6);\n\n  const benefits = [\n    {\n      icon: <Percent className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Affordable Modest Fashion\',\n      description: \'Elegant abayas, jalabiyas, and modest gowns starting from \342\202\2462,000, making modest luxury accessible to everyone.\'\n    },\n    {\n      icon: <PackageCheck className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Hand-Selected Grade-A Thrift\',\n      description: \'Each thrift piece is individually inspected for beauty, fabric integrity, and authentic modest design.\'\n    },\n    {\n      icon: <Sparkles className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Washed, Ironed & Neatly Packed\',\n      description: \'Ready-to-wear convenience. Every piece arrives clean, steam-ironed, and carefully packaged.\'\n    },\n    {\n      icon: <Store className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Individual & Wholesale Purchasing\',\n      description: \'Shop single favorite pieces or order wholesale bales and bundles for boutique owners and resellers.\'\n    },\n    {\n      icon: <Truck className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Nationwide Nigerian Delivery\',\n      description: \'Fast, secure waybill and park dispatch from Ijebu Ode to Lagos, Ibadan, Abeokuta, Abuja, and all states.\'\n    },\n    {\n      icon: <MessageCircle className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Convenient WhatsApp Ordering\',\n      description: \'Instant photo inquiry, fast replies, personalized sizing assistance, and zero complicated checkout forms.\'\n    },\n  ];\n\n  return (\n    <div id=\"home-view\" className=\"space-y-16 sm:space-y-24 pb-12\">\n      \n      {/* 1. HERO SECTION */}\n      <section \n        id=\"hero-section\" \n        className=\"relative bg-gradient-to-b from-[#F5EFE6] via-[#FAF8F5] to-[#FAF8F5] pt-8 sm:pt-16 pb-12 sm:pb-20 border-b border-[#EAE2D7] overflow-hidden\"\n      >\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center\">\n            \n            {/* Left Column: Typography & CTAs */}\n            <div className=\"lg:col-span-7 space-y-6 text-center lg:text-left\">\n              \n              {/* Trust Badge */}\n              <div className=\"inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E2D6C5] px-3.5 py-1.5 rounded-full shadow-2xs\">\n                <Sparkles className=\"w-4 h-4 text-[#8C6D37]\" />\n                <span className=\"text-xs font-semibold text-[#1C1917] tracking-wide\">\n                  Ijebu Ode\342\200\231s Favorite Modest Thrift Store\n                </span>\n              </div>\n\n              {/* Headline */}\n              <h1 \n                id=\"hero-headline\"\n                className=\"font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1C1917] leading-[1.12]\"\n              >\n                Elegant Modest Wear, <br className=\"hidden sm:inline\" />\n                <span className=\"italic font-normal text-[#8C6D37]\">Beautifully Within Reach.</span>\n              </h1>\n\n              {/* Supporting Text */}\n              <p \n                id=\"hero-supporting-text\"\n                className=\"text-base sm:text-lg text-[#5A544C] max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal\"\n              >\n                Discover affordable thrift abayas, jalabiyas, dresses, and modest fashion pieces for women, men, and kids. Hand-selected, washed, ironed, and neatly packed.\n              </p>\n\n              {/* CTAs */}\n              <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4\">\n                <button\n                  id=\"hero-primary-shop-cta\"\n                  onClick={() => {\n                    onNavigate(\'shop\');\n                    window.scrollTo({ top: 0, behavior: \'smooth\' });\n                  }}\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#1C1917] hover:bg-[#8C6D37] text-white font-semibold px-8 py-4 rounded-full shadow-md transition-all duration-300 group\"\n                >\n                  <span>Shop Collection</span>\n                  <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                </button>\n\n                <a\n                  id=\"hero-whatsapp-order-cta\"\n                  href={BUSINESS_INFO.whatsappUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold px-7 py-4 rounded-full shadow-md transition-all duration-300\"\n                >\n                  <MessageCircle className=\"w-5 h-5 fill-white\" />\n                  <span>Order on WhatsApp</span>\n                </a>\n              </div>\n\n              {/* Trust/Location line & Rating */}\n              <div className=\"pt-4 border-t border-[#EAE2D7]/80 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 text-xs text-[#6B655D]\">\n                <div className=\"flex items-center gap-1.5 font-medium text-[#1C1917]\">\n                  <MapPin className=\"w-4 h-4 text-[#8C6D37]\" />\n                  <span>Based in Ijebu Ode, Ogun State \342\200\242 Delivering across Nigeria</span>\n                </div>\n                <span className=\"hidden sm:inline text-[#D9CFC4]\">|</span>\n                <TrustRatingBadge variant=\"compact\" />\n              </div>\n\n            </div>\n\n            {/* Right Column: Hero Visual Asset */}\n            <div className=\"lg:col-span-5 relative\">\n              <div className=\"relative mx-auto max-w-md lg:max-w-none\">\n                \n                {/* Visual Frame */}\n                <div className=\"relative aspect-4/5 sm:aspect-3/4 rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-[#EAE2D7]\">\n                  <img\n                    src=\"/src/assets/images/hero_abaya_banner_1789895058317.jpg\"\n                    alt=\"Pearls Elegance Modest Abaya Collection\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover object-center\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\"></div>\n\n                  {/* Overlay Floater */}\n                  <div className=\"absolute bottom-5 left-5 right-5 p-4 bg-white/95 backdrop-blur-md rounded-2xl border border-[#EAE2D7] shadow-lg\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <span className=\"text-[10px] uppercase tracking-wider font-bold text-[#8C6D37] block\">\n                          Featured Selection\n                        </span>\n                        <h4 className=\"font-serif text-base font-bold text-[#1C1917]\">\n                          Thrift Abayas & Kinomo Sets\n                        </h4>\n                        <p className=\"text-xs text-[#5A544C]\">\n                          Starting from \342\202\2469,000 \342\200\242 Ready to wear\n                        </p>\n                      </div>\n                      <button\n                        onClick={() => onNavigate(\'shop\')}\n                        className=\"p-2.5 rounded-full bg-[#1C1917] text-white hover:bg-[#8C6D37] transition-colors\"\n                        aria-label=\"View items\"\n                      >\n                        <ArrowRight className=\"w-4 h-4\" />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Decorative floating badge */}\n                <div className=\"hidden sm:flex absolute -top-4 -left-4 bg-[#FAF8F5] border border-[#E2D6C5] p-3.5 rounded-2xl shadow-lg items-center gap-3\">\n                  <div className=\"w-9 h-9 rounded-xl bg-[#FAF0DE] flex items-center justify-center text-[#8C6D37]\">\n                    <PackageCheck className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] uppercase tracking-wider text-[#8A847C] font-semibold block\">Quality Assurance</span>\n                    <span className=\"text-xs font-bold text-[#1C1917]\">Washed & Steam-Ironed</span>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 2. FEATURED CATEGORIES SECTION */}\n      <section id=\"categories-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-2xl mx-auto mb-10\">\n          <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n            Explore The Range\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1 mb-2\">\n            Shop By Category\n          </h2>\n          <p className=\"text-sm text-[#5A544C]\">\n            Carefully curated modest fashion for women, men, kids, and wholesale buyers.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4\">\n          {[\n            { name: \'Abayas\', price: \'From \342\202\2469,000\', icon: \'\360\237\221\227\', cat: \'Abayas\' },\n            { name: \'Jalabiyas\', price: \'From \342\202\2466,000\', icon: \'\360\237\221\230\', cat: \'Jalabiyas\' },\n            { name: \'Kinomo Sets\', price: \'\342\202\24610,000\342\200\223\342\202\24615k\', icon: \'\342\234\250\', cat: \'Kinomo\' },\n            { name: \'Kiddies Wear\', price: \'From \342\202\2466,000\', icon: \'\360\237\221\247\', cat: \'Kiddies Wear\' },\n            { name: \'Tops & Gowns\', price: \'From \342\202\2462,000\', icon: \'\360\237\221\232\', cat: \'Thrift Tops & Gowns\' },\n            { name: \'Wholesale Bales\', price: \'Bulk Packs\', icon: \'\360\237\223\246\', cat: \'Wholesale / Bulk\' },\n          ].map((item, idx) => (\n            <button\n              key={idx}\n              id={`cat-card-${item.name.toLowerCase().replace(/\\s+/g, \'-\')}`}\n              onClick={() => {\n                if (item.cat === \'Wholesale / Bulk\') {\n                  onNavigate(\'wholesale\');\n                } else {\n                  onSelectCategory(item.cat as ProductCategory);\n                  onNavigate(\'shop\');\n                }\n                window.scrollTo({ top: 0, behavior: \'smooth\' });\n              }}\n              className=\"p-4 sm:p-5 rounded-2xl bg-white border border-[#EAE2D7] hover:border-[#C5A059] hover:shadow-md transition-all text-left flex flex-col justify-between group\"\n            >\n              <div>\n                <span className=\"text-2xl mb-3 block group-hover:scale-110 transition-transform\">\n                  {item.icon}\n                </span>\n                <h3 className=\"font-serif text-base font-bold text-[#1C1917] group-hover:text-[#8C6D37] transition-colors\">\n                  {item.name}\n                </h3>\n              </div>\n              <div className=\"mt-3 pt-2 border-t border-[#F5EFE6] flex items-center justify-between text-xs text-[#8A847C]\">\n                <span>{item.price}</span>\n                <ArrowRight className=\"w-3 h-3 group-hover:translate-x-1 transition-transform text-[#8C6D37]\" />\n              </div>\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* 3. FEATURED PRODUCTS SECTION */}\n      <section id=\"featured-products-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4\">\n          <div>\n            <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n              Available Now In Ijebu Ode\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1\">\n              Featured Modest Wear\n            </h2>\n            <p className=\"text-sm text-[#5A544C] mt-1\">\n              Authentic pricing in Nigerian Naira (\342\202\246). Handpicked thrift pieces & new arrivals.\n            </p>\n          </div>\n\n          <button\n            id=\"view-all-shop-btn\"\n            onClick={() => {\n              onNavigate(\'shop\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"inline-flex items-center gap-2 text-xs uppercase tracking-wider font-bold text-[#1C1917] hover:text-[#8C6D37] transition-colors py-2 border-b-2 border-[#1C1917] hover:border-[#8C6D37] self-start md:self-auto\"\n          >\n            <span>View Full Catalog ({products.length} items)</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {featuredProducts.map((product) => (\n            <ProductCard\n              key={product.id}\n              product={product}\n              onSelectProduct={onSelectProduct}\n              isInInquiryList={inquiryListIds.includes(product.id)}\n              onToggleInquiryList={onToggleInquiryList}\n            />\n          ))}\n        </div>\n      </section>\n\n      {/* 4. NEW ARRIVALS SPOTLIGHT */}\n      <section \n        id=\"new-arrivals-banner-section\" \n        className=\"bg-[#F5EFE6] border-y border-[#E2D6C5] py-14\"\n      >\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex flex-col lg:flex-row items-center justify-between gap-8 mb-10\">\n            <div>\n              <div className=\"inline-flex items-center gap-1.5 bg-[#1C1917] text-white text-[11px] font-semibold px-3 py-1 rounded-full mb-3 uppercase tracking-wider\">\n                <Sparkles className=\"w-3 h-3 text-[#C5A059]\" />\n                Fresh Shipment Drop\n              </div>\n              <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917]\">\n                New Arrival Abayas & Jalabias\n              </h2>\n              <p className=\"text-sm text-[#5A544C] max-w-xl mt-2\">\n                Including adult jalabias around \342\202\2466,000, new arrival abayas around \342\202\24612,000, and elegant thrift kinomo sets with matching inner dresses.\n              </p>\n            </div>\n\n            <button\n              id=\"see-all-arrivals-btn\"\n              onClick={() => {\n                onNavigate(\'new-arrivals\');\n                window.scrollTo({ top: 0, behavior: \'smooth\' });\n              }}\n              className=\"inline-flex items-center gap-2 bg-[#1C1917] hover:bg-[#8C6D37] text-white font-semibold text-xs px-6 py-3.5 rounded-full transition-all\"\n            >\n              <span>Explore All New Arrivals</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {newArrivals.map((product) => (\n              <ProductCard\n                key={product.id}\n                product={product}\n                onSelectProduct={onSelectProduct}\n                isInInquiryList={inquiryListIds.includes(product.id)}\n                onToggleInquiryList={onToggleInquiryList}\n              />\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 5. WHY SHOP WITH PEARLS ELEGANCE? */}\n      <section id=\"why-shop-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-2xl mx-auto mb-12\">\n          <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n            Quality & Trust\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1 mb-2\">\n            Why Shop With Pearls Elegance?\n          </h2>\n          <p className=\"text-sm text-[#5A544C]\">\n            We bridge the gap between affordable thrift pricing and premium modest styling.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {benefits.map((benefit, idx) => (\n            <div \n              key={idx}\n              className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs hover:border-[#D5C6B1] transition-all\"\n            >\n              <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] flex items-center justify-center mb-4\">\n                {benefit.icon}\n              </div>\n              <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n                {benefit.title}\n              </h3>\n              <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n                {benefit.description}\n              </p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 6. WHOLESALE & RESELLERS SECTION (\"Buying for Resale?\") */}\n      <section id=\"wholesale-banner-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-gradient-to-r from-[#1C1917] via-[#2A2623] to-[#1C1917] text-white rounded-3xl p-8 sm:p-12 border border-[#3A3530] shadow-xl\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            \n            <div className=\"lg:col-span-8 space-y-4\">\n              <span className=\"inline-flex items-center gap-1.5 bg-[#C5A059] text-[#1C1917] text-[10px] uppercase tracking-wider font-bold px-3 py-1 rounded-full\">\n                For Resellers & Retailers\n              </span>\n              <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-white\">\n                Buying for Resale? Stock Your Store With Affordable Modest Fashion.\n              </h2>\n              <p className=\"text-sm text-[#D5CEC4] max-w-xl leading-relaxed\">\n                We provide wholesale bales and bulk purchase packages for boutique owners, online vendors, and fashion retailers across Nigeria. Get high-margin thrift abayas and jalabiyas that sell out fast.\n              </p>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2\">\n                <div className=\"flex items-center gap-2 text-xs text-[#EAE2D7]\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n                  <span>Boutique Owners</span>\n                </div>\n                <div className=\"flex items-center gap-2 text-xs text-[#EAE2D7]\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n                  <span>Online & IG Vendors</span>\n                </div>\n                <div className=\"flex items-center gap-2 text-xs text-[#EAE2D7]\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n                  <span>Bulk Waybill Across Nigeria</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center\">\n              <button\n                id=\"wholesale-banner-page-btn\"\n                onClick={() => {\n                  onNavigate(\'wholesale\');\n                  window.scrollTo({ top: 0, behavior: \'smooth\' });\n                }}\n                className=\"w-full py-3.5 px-6 bg-[#FAF8F5] hover:bg-white text-[#1C1917] font-semibold rounded-2xl text-xs sm:text-sm text-center transition-colors shadow-md\"\n              >\n                Ask About Wholesale\n              </button>\n\n              <a\n                id=\"wholesale-banner-whatsapp-btn\"\n                href=\"https://wa.me/2348112444087?text=Hello%20Pearls%20Elegance%2C%20I%20am%20interested%20in%20wholesale%20and%20bulk%20abayas%20for%20resale.\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl text-xs sm:text-sm text-center transition-colors flex items-center justify-center gap-2\"\n              >\n                <MessageCircle className=\"w-4 h-4 fill-white\" />\n                <span>WhatsApp Reseller Desk</span>\n              </a>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 7. VISIT OUR STORE & GOOGLE VERIFIED TRUST */}\n      <section id=\"location-and-trust-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Location Box */}\n          <div className=\"lg:col-span-7 bg-white p-6 sm:p-8 rounded-3xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n            <div>\n              <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n                Ijebu Ode Physical Location\n              </span>\n              <h3 className=\"font-serif text-2xl sm:text-3xl font-bold text-[#1C1917] mt-1 mb-3\">\n                Visit Our Store in Ijebu Ode\n              </h3>\n              <p className=\"text-sm text-[#5A544C] mb-6\">\n                Prefer to view items in person? Walk into our store at Ibadan Garage Side in Ijebu Ode to inspect fabrics, try on abayas, or pick up your orders.\n              </p>\n\n              <div className=\"space-y-3.5 text-xs text-[#4A453E] mb-6\">\n                <div className=\"flex items-start gap-3\">\n                  <MapPin className=\"w-4 h-4 text-[#8C6D37] shrink-0 mt-0.5\" />\n                  <div>\n                    <span className=\"font-bold text-[#1C1917] block\">Physical Store Address:</span>\n                    <span>{BUSINESS_INFO.address}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <Clock className=\"w-4 h-4 text-[#8C6D37] shrink-0\" />\n                  <div>\n                    <span className=\"font-bold text-[#1C1917] inline\">Opening Hours: </span>\n                    <span>{BUSINESS_INFO.openingHours}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <Truck className=\"w-4 h-4 text-[#8C6D37] shrink-0\" />\n                  <div>\n                    <span className=\"font-bold text-[#1C1917] inline\">Delivery Support: </span>\n                    <span>Direct park dispatch & waybill to all 36 Nigerian States.</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-[#F2EBE1] flex flex-wrap gap-3\">\n              <a\n                id=\"location-google-maps-btn\"\n                href=\"https://www.google.com/maps/search/?api=1&query=Ibadan+Garage+Side+Ijebu+Ode+Ogun+State+Nigeria\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"py-2.5 px-4 rounded-xl bg-[#1C1917] hover:bg-[#8C6D37] text-white text-xs font-semibold flex items-center gap-1.5 transition-colors\"\n              >\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Get Directions / Google Maps</span>\n              </a>\n\n              <a\n                id=\"location-phone-btn\"\n                href={`tel:${BUSINESS_INFO.phoneRaw}`}\n                className=\"py-2.5 px-4 rounded-xl border border-[#D9CFC4] hover:bg-[#F5EFE6] text-[#1C1917] text-xs font-semibold flex items-center gap-1.5 transition-colors\"\n              >\n                <span>Call Store: 0811 244 4087</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Customer Trust Card (Strictly 5.0 Google rating from 1 Google review) */}\n          <div className=\"lg:col-span-5 flex flex-col justify-between\">\n            <TrustRatingBadge variant=\"card\" />\n\n            <div className=\"mt-4 p-6 bg-[#FAF0DE]/70 border border-[#E8D4B0] rounded-2xl\">\n              <div className=\"flex items-center gap-2 text-xs text-[#8C6D37] font-bold uppercase tracking-wider mb-1.5\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>Transparent & Honest Policy</span>\n              </div>\n              <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n                We believe in genuine communication. What you see is what you get. Every item is washed, ironed, and ready to style. Contact us anytime for photos or video clips of exact pieces on WhatsApp.\n              </p>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n    </div>\n  );\n};\n"
        replacement_content: "import React from \'react\';\nimport { \n  ArrowRight, \n  MessageCircle, \n  Sparkles, \n  ShieldCheck, \n  Sparkle, \n  ShoppingBag, \n  Truck, \n  Clock, \n  MapPin, \n  CheckCircle2, \n  Layers, \n  Store, \n  PackageCheck,\n  Percent\n} from \'lucide-react\';\nimport { Product, ProductCategory } from \'../types\';\nimport { ProductCard } from \'../components/ProductCard\';\nimport { TrustRatingBadge } from \'../components/TrustRatingBadge\';\nimport { BUSINESS_INFO, CATEGORIES } from \'../data/products\';\n\ninterface HomeViewProps {\n  products: Product[];\n  onSelectProduct: (product: Product) => void;\n  onNavigate: (view: string) => void;\n  onSelectCategory: (category: ProductCategory) => void;\n  inquiryListIds: string[];\n  onToggleInquiryList: (product: Product) => void;\n}\n\nexport const HomeView: React.FC<HomeViewProps> = ({\n  products,\n  onSelectProduct,\n  onNavigate,\n  onSelectCategory,\n  inquiryListIds,\n  onToggleInquiryList,\n}) => {\n  const newArrivals = products.filter((p) => p.isNewArrival);\n  const featuredProducts = products.slice(0, 6);\n\n  const benefits = [\n    {\n      icon: <Percent className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Affordable Modest Fashion\',\n      description: \'Elegant abayas, jalabiyas, and modest gowns starting from \342\202\2462,000, making modest elegance accessible to everyone.\'\n    },\n    {\n      icon: <PackageCheck className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Hand-Selected Quality Thrift\',\n      description: \'Each thrift piece is individually inspected for beauty, fabric integrity, and authentic modest design.\'\n    },\n    {\n      icon: <Sparkles className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Washed, Ironed & Neatly Packed\',\n      description: \'Ready-to-wear convenience. Every piece arrives clean, steam-ironed, and carefully packaged.\'\n    },\n    {\n      icon: <Store className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Retail & Wholesale Purchasing\',\n      description: \'Shop single favorite pieces or place bulk purchase orders for boutique owners and resellers.\'\n    },\n    {\n      icon: <Truck className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Delivering Across Nigeria\',\n      description: \'Reliable delivery and waybill dispatch from our physical store in Ijebu Ode to customers across Nigeria.\'\n    },\n    {\n      icon: <MessageCircle className=\"w-5 h-5 text-[#8C6D37]\" />,\n      title: \'Direct WhatsApp Ordering\',\n      description: \'Instant photo inquiry, fast replies, personalized sizing assistance, and direct communication.\'\n    },\n  ];\n\n  return (\n    <div id=\"home-view\" className=\"space-y-16 sm:space-y-24 pb-12\">\n      \n      {/* 1. HERO SECTION */}\n      <section \n        id=\"hero-section\" \n        className=\"relative bg-gradient-to-b from-[#F5EFE6] via-[#FAF8F5] to-[#FAF8F5] pt-8 sm:pt-16 pb-12 sm:pb-20 border-b border-[#EAE2D7] overflow-hidden\"\n      >\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center\">\n            \n            {/* Left Column: Typography & CTAs */}\n            <div className=\"lg:col-span-7 space-y-6 text-center lg:text-left\">\n              \n              {/* Location Badge */}\n              <div className=\"inline-flex items-center gap-2 bg-[#FAF8F5] border border-[#E2D6C5] px-3.5 py-1.5 rounded-full shadow-2xs\">\n                <Sparkles className=\"w-4 h-4 text-[#8C6D37]\" />\n                <span className=\"text-xs font-semibold text-[#1C1917] tracking-wide\">\n                  Ijebu Ode, Ogun State \342\200\242 Modest Fashion Store\n                </span>\n              </div>\n\n              {/* Exact Headline */}\n              <h1 \n                id=\"hero-headline\"\n                className=\"font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1C1917] leading-[1.12]\"\n              >\n                Elegant Modest Wear, <br className=\"hidden sm:inline\" />\n                <span className=\"italic font-normal text-[#8C6D37]\">Beautifully Within Reach.</span>\n              </h1>\n\n              {/* Exact Supporting Text */}\n              <p \n                id=\"hero-supporting-text\"\n                className=\"text-base sm:text-lg text-[#5A544C] max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal\"\n              >\n                Discover affordable thrift abayas, jalabiyas, dresses, and modest fashion pieces for women, men, and kids.\n              </p>\n\n              {/* CTAs: Primary = Shop New Arrivals, Secondary = Order on WhatsApp */}\n              <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4\">\n                <button\n                  id=\"hero-primary-shop-cta\"\n                  onClick={() => {\n                    onNavigate(\'new-arrivals\');\n                    window.scrollTo({ top: 0, behavior: \'smooth\' });\n                  }}\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#1C1917] hover:bg-[#8C6D37] text-white font-semibold px-8 py-4 rounded-full shadow-md transition-all duration-300 group\"\n                >\n                  <span>Shop New Arrivals</span>\n                  <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                </button>\n\n                <a\n                  id=\"hero-whatsapp-order-cta\"\n                  href={BUSINESS_INFO.whatsappUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold px-7 py-4 rounded-full shadow-md transition-all duration-300\"\n                >\n                  <MessageCircle className=\"w-5 h-5 fill-white\" />\n                  <span>Order on WhatsApp</span>\n                </a>\n              </div>\n\n              {/* Trust/Location line & Rating */}\n              <div className=\"pt-4 border-t border-[#EAE2D7]/80 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 text-xs text-[#6B655D]\">\n                <div className=\"flex items-center gap-1.5 font-medium text-[#1C1917]\">\n                  <MapPin className=\"w-4 h-4 text-[#8C6D37]\" />\n                  <span>Based in Ijebu Ode, Ogun State \342\200\242 Delivering across Nigeria</span>\n                </div>\n                <span className=\"hidden sm:inline text-[#D9CFC4]\">|</span>\n                <TrustRatingBadge variant=\"compact\" />\n              </div>\n\n            </div>\n\n            {/* Right Column: Hero Visual Asset */}\n            <div className=\"lg:col-span-5 relative\">\n              <div className=\"relative mx-auto max-w-md lg:max-w-none\">\n                \n                {/* Visual Frame */}\n                <div className=\"relative aspect-4/5 sm:aspect-3/4 rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-[#EAE2D7]\">\n                  <img\n                    src=\"/src/assets/images/hero_abaya_banner_1789895058317.jpg\"\n                    alt=\"Pearls Elegance Modest Abaya Collection\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover object-center\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\"></div>\n\n                  {/* Overlay Floater */}\n                  <div className=\"absolute bottom-5 left-5 right-5 p-4 bg-white/95 backdrop-blur-md rounded-2xl border border-[#EAE2D7] shadow-lg\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <span className=\"text-[10px] uppercase tracking-wider font-bold text-[#8C6D37] block\">\n                          Featured Selection\n                        </span>\n                        <h4 className=\"font-serif text-base font-bold text-[#1C1917]\">\n                          Thrift Abayas & Kinomo Sets\n                        </h4>\n                        <p className=\"text-xs text-[#5A544C]\">\n                          Starting from \342\202\2469,000 \342\200\242 Ready to wear\n                        </p>\n                      </div>\n                      <button\n                        onClick={() => onNavigate(\'shop\')}\n                        className=\"p-2.5 rounded-full bg-[#1C1917] text-white hover:bg-[#8C6D37] transition-colors\"\n                        aria-label=\"View items\"\n                      >\n                        <ArrowRight className=\"w-4 h-4\" />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Decorative floating badge */}\n                <div className=\"hidden sm:flex absolute -top-4 -left-4 bg-[#FAF8F5] border border-[#E2D6C5] p-3.5 rounded-2xl shadow-lg items-center gap-3\">\n                  <div className=\"w-9 h-9 rounded-xl bg-[#FAF0DE] flex items-center justify-center text-[#8C6D37]\">\n                    <PackageCheck className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] uppercase tracking-wider text-[#8A847C] font-semibold block\">Care & Cleanliness</span>\n                    <span className=\"text-xs font-bold text-[#1C1917]\">Washed & Steam-Ironed</span>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 2. HIGHLY VISIBLE NEW ARRIVALS SECTION (Directly after Hero) */}\n      <section \n        id=\"new-arrivals-banner-section\" \n        className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"\n      >\n        <div className=\"bg-[#F5EFE6] border border-[#E2D6C5] rounded-3xl p-6 sm:p-10\">\n          <div className=\"flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 mb-8\">\n            <div>\n              <div className=\"inline-flex items-center gap-1.5 bg-[#1C1917] text-white text-[11px] font-semibold px-3 py-1 rounded-full mb-2 uppercase tracking-wider\">\n                <Sparkles className=\"w-3 h-3 text-[#C5A059]\" />\n                Latest Stock Drop\n              </div>\n              <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917]\">\n                New Arrivals\n              </h2>\n              <p className=\"text-sm text-[#5A544C] max-w-xl mt-1\">\n                Explore our latest stock including clean white adult jalabias (\342\202\2466,000), new arrival abayas (\342\202\24612,000), and thrift kinomo with new inner dress sets (\342\202\24610,000\342\200\223\342\202\24615,000).\n              </p>\n            </div>\n\n            <button\n              id=\"see-all-arrivals-btn\"\n              onClick={() => {\n                onNavigate(\'new-arrivals\');\n                window.scrollTo({ top: 0, behavior: \'smooth\' });\n              }}\n              className=\"inline-flex items-center gap-2 bg-[#1C1917] hover:bg-[#8C6D37] text-white font-semibold text-xs px-6 py-3.5 rounded-full transition-all shrink-0\"\n            >\n              <span>View All New Arrivals</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {newArrivals.map((product) => (\n              <ProductCard\n                key={product.id}\n                product={product}\n                onSelectProduct={onSelectProduct}\n                isInInquiryList={inquiryListIds.includes(product.id)}\n                onToggleInquiryList={onToggleInquiryList}\n              />\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 3. FEATURED CATEGORIES SECTION */}\n      <section id=\"categories-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-2xl mx-auto mb-10\">\n          <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n            Explore The Range\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1 mb-2\">\n            Shop By Category\n          </h2>\n          <p className=\"text-sm text-[#5A544C]\">\n            Carefully curated modest fashion for women, men, kids, and wholesale buyers.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4\">\n          {[\n            { name: \'Abayas\', price: \'From \342\202\2469,000\', icon: \'\360\237\221\227\', cat: \'Abayas\' },\n            { name: \'Jalabiyas\', price: \'From \342\202\2466,000\', icon: \'\360\237\221\230\', cat: \'Jalabiyas\' },\n            { name: \'Kinomo Sets\', price: \'\342\202\24610,000\342\200\223\342\202\24615k\', icon: \'\342\234\250\', cat: \'Kinomo\' },\n            { name: \'Kiddies Wear\', price: \'From \342\202\2466,000\', icon: \'\360\237\221\247\', cat: \'Kiddies Wear\' },\n            { name: \'Tops & Gowns\', price: \'From \342\202\2462,000\', icon: \'\360\237\221\232\', cat: \'Thrift Tops & Gowns\' },\n            { name: \'Wholesale / Bulk\', price: \'Bulk Orders\', icon: \'\360\237\223\246\', cat: \'Wholesale / Bulk\' },\n          ].map((item, idx) => (\n            <button\n              key={idx}\n              id={`cat-card-${item.name.toLowerCase().replace(/[\\s\\/]+/g, \'-\')}`}\n              onClick={() => {\n                if (item.cat === \'Wholesale / Bulk\') {\n                  onNavigate(\'wholesale\');\n                } else {\n                  onSelectCategory(item.cat as ProductCategory);\n                  onNavigate(\'shop\');\n                }\n                window.scrollTo({ top: 0, behavior: \'smooth\' });\n              }}\n              className=\"p-4 sm:p-5 rounded-2xl bg-white border border-[#EAE2D7] hover:border-[#C5A059] hover:shadow-md transition-all text-left flex flex-col justify-between group\"\n            >\n              <div>\n                <span className=\"text-2xl mb-3 block group-hover:scale-110 transition-transform\">\n                  {item.icon}\n                </span>\n                <h3 className=\"font-serif text-base font-bold text-[#1C1917] group-hover:text-[#8C6D37] transition-colors\">\n                  {item.name}\n                </h3>\n              </div>\n              <div className=\"mt-3 pt-2 border-t border-[#F5EFE6] flex items-center justify-between text-xs text-[#8A847C]\">\n                <span>{item.price}</span>\n                <ArrowRight className=\"w-3 h-3 group-hover:translate-x-1 transition-transform text-[#8C6D37]\" />\n              </div>\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* 4. FEATURED PRODUCTS SECTION */}\n      <section id=\"featured-products-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4\">\n          <div>\n            <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n              Available In Store\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1\">\n              Featured Modest Wear\n            </h2>\n            <p className=\"text-sm text-[#5A544C] mt-1\">\n              Verified pricing in Nigerian Naira (\342\202\246). Hand-selected thrift pieces & new arrivals.\n            </p>\n          </div>\n\n          <button\n            id=\"view-all-shop-btn\"\n            onClick={() => {\n              onNavigate(\'shop\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"inline-flex items-center gap-2 text-xs uppercase tracking-wider font-bold text-[#1C1917] hover:text-[#8C6D37] transition-colors py-2 border-b-2 border-[#1C1917] hover:border-[#8C6D37] self-start md:self-auto\"\n          >\n            <span>View Full Catalog ({products.length} items)</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {featuredProducts.map((product) => (\n            <ProductCard\n              key={product.id}\n              product={product}\n              onSelectProduct={onSelectProduct}\n              isInInquiryList={inquiryListIds.includes(product.id)}\n              onToggleInquiryList={onToggleInquiryList}\n            />\n          ))}\n        </div>\n      </section>\n\n      {/* 5. WHY SHOP WITH PEARLS ELEGANCE? */}\n      <section id=\"why-shop-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-2xl mx-auto mb-12\">\n          <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n            Quality & Trust\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1 mb-2\">\n            Why Shop With Pearls Elegance?\n          </h2>\n          <p className=\"text-sm text-[#5A544C]\">\n            We provide affordable thrift pricing with carefully inspected modest styling.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {benefits.map((benefit, idx) => (\n            <div \n              key={idx}\n              className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs hover:border-[#D5C6B1] transition-all\"\n            >\n              <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] flex items-center justify-center mb-4\">\n                {benefit.icon}\n              </div>\n              <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n                {benefit.title}\n              </h3>\n              <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n                {benefit.description}\n              </p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 6. WHOLESALE & RESELLERS SECTION (\"Buying for Resale?\") */}\n      <section id=\"wholesale-banner-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#1C1917] text-white rounded-3xl p-8 sm:p-12 border border-[#3A3530] shadow-xl\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            \n            <div className=\"lg:col-span-8 space-y-4\">\n              <span className=\"inline-flex items-center gap-1.5 bg-[#C5A059] text-[#1C1917] text-[10px] uppercase tracking-wider font-bold px-3 py-1 rounded-full\">\n                For Resellers & Boutique Owners\n              </span>\n              <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-white\">\n                Buying for Resale? Stock Your Store With Affordable Modest Fashion.\n              </h2>\n              <p className=\"text-sm text-[#D5CEC4] max-w-xl leading-relaxed\">\n                We provide wholesale and bulk purchase packages for boutique owners, online vendors, and fashion retailers across Nigeria. Get fast-moving thrift abayas and jalabiyas for your business.\n              </p>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2\">\n                <div className=\"flex items-center gap-2 text-xs text-[#EAE2D7]\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n                  <span>Boutique Owners</span>\n                </div>\n                <div className=\"flex items-center gap-2 text-xs text-[#EAE2D7]\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n                  <span>Online & IG Vendors</span>\n                </div>\n                <div className=\"flex items-center gap-2 text-xs text-[#EAE2D7]\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n                  <span>Delivery Across Nigeria</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center\">\n              <button\n                id=\"wholesale-banner-page-btn\"\n                onClick={() => {\n                  onNavigate(\'wholesale\');\n                  window.scrollTo({ top: 0, behavior: \'smooth\' });\n                }}\n                className=\"w-full py-3.5 px-6 bg-[#FAF8F5] hover:bg-white text-[#1C1917] font-semibold rounded-2xl text-xs sm:text-sm text-center transition-colors shadow-md\"\n              >\n                Ask About Wholesale\n              </button>\n\n              <a\n                id=\"wholesale-banner-whatsapp-btn\"\n                href=\"https://wa.me/2348112444087?text=Hello%20Pearls%20Elegance%2C%20I%20am%20interested%20in%20wholesale%20and%20bulk%20abayas%20for%20resale.\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl text-xs sm:text-sm text-center transition-colors flex items-center justify-center gap-2\"\n              >\n                <MessageCircle className=\"w-4 h-4 fill-white\" />\n                <span>WhatsApp Reseller Desk</span>\n              </a>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 7. VISIT OUR STORE & GOOGLE VERIFIED TRUST */}\n      <section id=\"location-and-trust-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Location Box */}\n          <div className=\"lg:col-span-7 bg-white p-6 sm:p-8 rounded-3xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n            <div>\n              <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n                Ijebu Ode Physical Location\n              </span>\n              <h3 className=\"font-serif text-2xl sm:text-3xl font-bold text-[#1C1917] mt-1 mb-3\">\n                Visit Our Store in Ijebu Ode\n              </h3>\n              <p className=\"text-sm text-[#5A544C] mb-6\">\n                Prefer to view items in person? Visit our store at Ibadan Garage Side in Ijebu Ode to inspect fabrics, choose pieces, or pick up your orders.\n              </p>\n\n              <div className=\"space-y-3.5 text-xs text-[#4A453E] mb-6\">\n                <div className=\"flex items-start gap-3\">\n                  <MapPin className=\"w-4 h-4 text-[#8C6D37] shrink-0 mt-0.5\" />\n                  <div>\n                    <span className=\"font-bold text-[#1C1917] block\">Physical Store Address:</span>\n                    <span>{BUSINESS_INFO.address}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <Clock className=\"w-4 h-4 text-[#8C6D37] shrink-0\" />\n                  <div>\n                    <span className=\"font-bold text-[#1C1917] inline\">Store Hours: </span>\n                    <span>{BUSINESS_INFO.openingHours}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <Truck className=\"w-4 h-4 text-[#8C6D37] shrink-0\" />\n                  <div>\n                    <span className=\"font-bold text-[#1C1917] inline\">Delivery Support: </span>\n                    <span>Reliable dispatch to all states across Nigeria.</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-[#F2EBE1] flex flex-wrap gap-3\">\n              <a\n                id=\"location-google-maps-btn\"\n                href=\"https://www.google.com/maps/search/?api=1&query=Ibadan+Garage+Side+Ijebu+Ode+Ogun+State+Nigeria\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"py-2.5 px-4 rounded-xl bg-[#1C1917] hover:bg-[#8C6D37] text-white text-xs font-semibold flex items-center gap-1.5 transition-colors\"\n              >\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>Get Directions / Google Maps</span>\n              </a>\n\n              <a\n                id=\"location-phone-btn\"\n                href={`tel:${BUSINESS_INFO.phoneRaw}`}\n                className=\"py-2.5 px-4 rounded-xl border border-[#D9CFC4] hover:bg-[#F5EFE6] text-[#1C1917] text-xs font-semibold flex items-center gap-1.5 transition-colors\"\n              >\n                <span>Call Store: 0811 244 4087</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Customer Trust Card (Strictly 5.0 Google rating from 1 Google review) */}\n          <div className=\"lg:col-span-5 flex flex-col justify-between\">\n            <TrustRatingBadge variant=\"card\" />\n\n            <div className=\"mt-4 p-6 bg-[#FAF0DE]/70 border border-[#E8D4B0] rounded-2xl\">\n              <div className=\"flex items-center gap-2 text-xs text-[#8C6D37] font-bold uppercase tracking-wider mb-1.5\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>Honest & Clear Communication</span>\n              </div>\n              <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n                We believe in genuine customer service. Every item is washed, ironed, and ready to wear. Contact us anytime for photos or video clips of exact pieces on WhatsApp.\n              </p>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
