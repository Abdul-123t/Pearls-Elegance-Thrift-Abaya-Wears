    instruction: "Refine the footer to deliver an exceptionally polished, quiet, and premium closing frame with the exact copyright, agency credit, and location without bullet separators."
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { \n  MapPin, \n  Phone, \n  MessageCircle, \n  ShieldCheck, \n  Clock, \n  Truck, \n  Sparkles,\n  ArrowUpRight,\n  Heart\n} from \'lucide-react\';\nimport { BUSINESS_INFO } from \'../data/products\';\n\ninterface FooterProps {\n  onNavigate: (view: string) => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ onNavigate }) => {\n  const currentYear = new Date().getFullYear();\n\n  const handleLinkClick = (view: string) => {\n    onNavigate(view);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer \n      id=\"main-footer\"\n      className=\"bg-[#141210] text-[#FAF8F5] pt-16 pb-28 md:pb-16 border-t border-[#26221F]\"\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Prominent Brand Headline Banner */}\n        <div className=\"border-b border-[#2A2522] pb-12 mb-14\">\n          <div className=\"flex flex-col lg:flex-row items-start lg:items-end justify-between gap-8\">\n            <div className=\"space-y-3 max-w-2xl\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-[#C5A059] text-xs uppercase tracking-[0.25em] font-semibold flex items-center gap-1.5\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  Ijebu Ode, Ogun State \342\200\242 Nigeria\n                </span>\n              </div>\n              <h2 className=\"font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight\">\n                Pearls Elegance <span className=\"text-[#C5A059] font-normal italic\">Thrift Abayas</span>\n              </h2>\n              <p className=\"text-sm sm:text-base text-[#B8AEA2] leading-relaxed\">\n                Carefully hand-selected, freshly washed, and steam-pressed modest wear\342\200\224bringing affordable elegance, dignity, and grace to women, men, and children across Nigeria.\n              </p>\n            </div>\n\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto\">\n              <button\n                onClick={() => handleLinkClick(\'shop\')}\n                className=\"px-6 py-3.5 bg-white text-[#1C1917] hover:bg-[#FAF8F5] text-xs font-semibold uppercase tracking-wider rounded-full transition-all text-center\"\n              >\n                Browse Collection\n              </button>\n              <a\n                id=\"footer-header-whatsapp-cta\"\n                href={BUSINESS_INFO.whatsappUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BE5B] text-white text-xs font-semibold uppercase tracking-wider px-6 py-3.5 rounded-full shadow-md transition-all text-center\"\n              >\n                <MessageCircle className=\"w-4 h-4 fill-white\" />\n                <span>Order on WhatsApp</span>\n              </a>\n            </div>\n          </div>\n        </div>\n\n        {/* Footer 4-Column Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-14\">\n          \n          {/* Col 1: Brand & Quality Pledge */}\n          <div className=\"space-y-4\">\n            <div className=\"space-y-1\">\n              <span className=\"font-serif text-2xl font-bold tracking-tight text-white block\">\n                Pearls Elegance\n              </span>\n              <span className=\"text-[11px] uppercase tracking-[0.2em] text-[#C5A059] font-semibold block\">\n                Thrift Abaya Wears\n              </span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-[#B8AEA2] leading-relaxed\">\n              Based in Ijebu Ode, providing high-quality grade-A thrift abayas, clean jalabiyas, kinomos, and modest garments with nationwide delivery.\n            </p>\n\n            <div className=\"pt-2\">\n              <div className=\"p-3.5 bg-[#1C1917] rounded-2xl border border-[#2E2926] flex items-center gap-3\">\n                <div className=\"w-9 h-9 rounded-xl bg-[#C5A059]/10 text-[#C5A059] flex items-center justify-center shrink-0\">\n                  <ShieldCheck className=\"w-5 h-5 text-[#C5A059]\" />\n                </div>\n                <div className=\"text-xs\">\n                  <span className=\"font-bold text-white block\">Quality Assured</span>\n                  <span className=\"text-[#998E82] text-[11px]\">Washed, pressed & ready to wear</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Col 2: Collections & Catalog */}\n          <div className=\"space-y-4\">\n            <h4 className=\"text-xs uppercase tracking-widest text-[#C5A059] font-bold\">\n              Collections\n            </h4>\n            <ul className=\"space-y-2.5 text-xs sm:text-sm text-[#D5CEC4]\">\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  All Modest Wears\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'new-arrivals\')} \n                  className=\"hover:text-[#C5A059] transition-colors flex items-center gap-1.5\"\n                >\n                  <span>New Arrivals Drop</span>\n                  <span className=\"text-[10px] bg-[#C5A059] text-[#1C1917] font-bold px-1.5 py-0.2 rounded-full\">New</span>\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  Thrift Abayas (From \342\202\2469,000)\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  Adult Jalabias (\342\202\2466,000)\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  Kiddies Abaya & Jalabia (\342\202\2466,000)\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  Thrift Tops & Gowns (From \342\202\2462,000)\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Business & Reseller */}\n          <div className=\"space-y-4\">\n            <h4 className=\"text-xs uppercase tracking-widest text-[#C5A059] font-bold\">\n              Business & Info\n            </h4>\n            <ul className=\"space-y-2.5 text-xs sm:text-sm text-[#D5CEC4]\">\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'wholesale\')} \n                  className=\"hover:text-[#C5A059] transition-colors flex items-center gap-1.5\"\n                >\n                  <span>Wholesale & Reseller Packs</span>\n                  <ArrowUpRight className=\"w-3.5 h-3.5 text-[#C5A059]\" />\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'about\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  About Our Brand & Values\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'contact\')} \n                  className=\"hover:text-[#C5A059] transition-colors text-left\"\n                >\n                  Store Location & Directions\n                </button>\n              </li>\n              <li className=\"pt-2 text-xs text-[#998E82] leading-relaxed\">\n                <span className=\"font-semibold text-white block mb-1\">Wholesale Orders:</span>\n                We supply resellers, student entrepreneurs, and boutiques nationwide at wholesale rates.\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 4: Store Contact & Location */}\n          <div className=\"space-y-4\">\n            <h4 className=\"text-xs uppercase tracking-widest text-[#C5A059] font-bold\">\n              Store & Orders\n            </h4>\n            <div className=\"space-y-3 text-xs sm:text-sm text-[#D5CEC4]\">\n              <div className=\"flex items-start gap-2.5\">\n                <MapPin className=\"w-4 h-4 text-[#C5A059] shrink-0 mt-1\" />\n                <span>\n                  {BUSINESS_INFO.address}\n                </span>\n              </div>\n\n              <div className=\"flex items-center gap-2.5\">\n                <Phone className=\"w-4 h-4 text-[#C5A059] shrink-0\" />\n                <a href={`tel:${BUSINESS_INFO.phoneRaw}`} className=\"hover:text-white font-medium\">\n                  {BUSINESS_INFO.phone}\n                </a>\n              </div>\n\n              <div className=\"flex items-center gap-2.5\">\n                <MessageCircle className=\"w-4 h-4 text-[#25D366] shrink-0\" />\n                <a \n                  href={BUSINESS_INFO.whatsappUrl} \n                  target=\"_blank\" \n                  rel=\"noopener noreferrer\"\n                  className=\"hover:text-white font-medium\"\n                >\n                  WhatsApp: {BUSINESS_INFO.phone}\n                </a>\n              </div>\n\n              <div className=\"flex items-start gap-2.5 pt-1 text-xs text-[#998E82]\">\n                <Clock className=\"w-4 h-4 text-[#C5A059] shrink-0 mt-0.5\" />\n                <span>{BUSINESS_INFO.openingHours}</span>\n              </div>\n\n              <div className=\"flex items-start gap-2.5 text-xs text-[#998E82]\">\n                <Truck className=\"w-4 h-4 text-[#C5A059] shrink-0 mt-0.5\" />\n                <span>Nationwide delivery via motor park waybills & door couriers</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom copyright & agency credit line */}\n        <div className=\"pt-8 border-t border-[#26221F] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#8C8275]\">\n          <div className=\"flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left\">\n            <p className=\"text-[#A89E91]\">\n              \302\251 {currentYear} <span className=\"text-[#E0D8CE] font-medium\">Pearls Elegance Thrift Abaya Wears</span>. All rights reserved.\n            </p>\n            <span className=\"hidden sm:inline text-[#4A433D]\">\342\200\242</span>\n            <p className=\"text-[#8C8275]\">\n              Designed & Engineered by <span className=\"text-[#C5A059] font-medium\">Namaco Technology Nigeria Limited</span>\n            </p>\n          </div>\n\n          <p className=\"flex items-center gap-1.5 text-[#8C8275]\">\n            <span>Ijebu Ode, Ogun State</span>\n            <span>\342\200\242</span>\n            <span>Nigeria</span>\n          </p>\n        </div>\n\n      </div>\n    </footer>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { \n  MapPin, \n  Phone, \n  MessageCircle, \n  Clock, \n  Truck, \n  ArrowUpRight\n} from \'lucide-react\';\nimport { BUSINESS_INFO } from \'../data/products\';\n\ninterface FooterProps {\n  onNavigate: (view: string) => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ onNavigate }) => {\n  const currentYear = new Date().getFullYear();\n\n  const handleLinkClick = (view: string) => {\n    onNavigate(view);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer \n      id=\"main-footer\"\n      className=\"bg-[#161412] text-[#FAF8F5] pt-16 sm:pt-20 pb-24 sm:pb-16 border-t border-[#26221F]\"\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Editorial Brand Intro Banner */}\n        <div className=\"border-b border-[#2A2622] pb-12 mb-12 sm:mb-16\">\n          <div className=\"flex flex-col lg:flex-row items-start lg:items-end justify-between gap-8\">\n            <div className=\"space-y-3 max-w-2xl\">\n              <span className=\"text-[11px] uppercase tracking-[0.24em] text-[#C5A059] font-medium block\">\n                Modest Fashion House \342\200\242 Ijebu Ode\n              </span>\n              <h2 className=\"font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight\">\n                Pearls Elegance <span className=\"text-[#C5A059] font-normal italic\">Thrift Abayas</span>\n              </h2>\n              <p className=\"text-sm sm:text-base text-[#A89E91] leading-relaxed font-normal\">\n                Carefully selected, washed, and pressed modest wear\342\200\224bringing affordable elegance, dignity, and grace to everyday wardrobes across Nigeria.\n              </p>\n            </div>\n\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto\">\n              <button\n                onClick={() => handleLinkClick(\'shop\')}\n                className=\"px-6 py-3.5 bg-white text-[#1C1917] hover:bg-[#FAF8F5] text-xs font-semibold uppercase tracking-wider rounded-full transition-all text-center\"\n              >\n                Browse Collection\n              </button>\n              <a\n                id=\"footer-header-whatsapp-cta\"\n                href={BUSINESS_INFO.whatsappUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BE5B] text-white text-xs font-semibold uppercase tracking-wider px-6 py-3.5 rounded-full shadow-sm transition-all text-center\"\n              >\n                <MessageCircle className=\"w-4 h-4 fill-white\" />\n                <span>Order on WhatsApp</span>\n              </a>\n            </div>\n          </div>\n        </div>\n\n        {/* 4-Column Navigation & Info Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-12 mb-16\">\n          \n          {/* Column 1: Brand Essence */}\n          <div className=\"space-y-3\">\n            <span className=\"font-serif text-2xl font-bold tracking-tight text-white block\">\n              Pearls Elegance\n            </span>\n            <span className=\"text-[10px] uppercase tracking-[0.22em] text-[#8C6D37] font-semibold block\">\n              Thrift Abaya Wears\n            </span>\n            <p className=\"text-xs sm:text-sm text-[#A89E91] leading-relaxed pt-1\">\n              Grade-A thrift abayas, jalabiyas, and modest ensembles in Ijebu Ode, Ogun State. Every piece is cleaned, steam-pressed, and packaged for immediate wear.\n            </p>\n          </div>\n\n          {/* Column 2: Collections */}\n          <div className=\"space-y-3.5\">\n            <h4 className=\"text-xs uppercase tracking-widest text-[#C5A059] font-bold\">\n              Collections\n            </h4>\n            <ul className=\"space-y-2.5 text-xs sm:text-sm text-[#D5CEC4]\">\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  All Modest Wears\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'new-arrivals\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  New Arrivals Drop\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  Thrift Abayas (From \342\202\2469,000)\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  Adult Jalabias (\342\202\2466,000)\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  Kiddies Abaya & Jalabia (\342\202\2466,000)\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'shop\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  Thrift Tops & Gowns (From \342\202\2462,000)\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Column 3: Business & Reseller */}\n          <div className=\"space-y-3.5\">\n            <h4 className=\"text-xs uppercase tracking-widest text-[#C5A059] font-bold\">\n              Information\n            </h4>\n            <ul className=\"space-y-2.5 text-xs sm:text-sm text-[#D5CEC4]\">\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'wholesale\')} \n                  className=\"hover:text-white transition-colors flex items-center gap-1.5\"\n                >\n                  <span>Wholesale & Reseller Packs</span>\n                  <ArrowUpRight className=\"w-3.5 h-3.5 text-[#C5A059]\" />\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'about\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  About Pearls Elegance\n                </button>\n              </li>\n              <li>\n                <button \n                  onClick={() => handleLinkClick(\'contact\')} \n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  Store Location & Directions\n                </button>\n              </li>\n              <li className=\"pt-2 text-xs text-[#8C8275] leading-relaxed\">\n                Wholesale bales and hand-selected bundles available for boutique retailers and online vendors.\n              </li>\n            </ul>\n          </div>\n\n          {/* Column 4: Store & Delivery Details */}\n          <div className=\"space-y-3.5\">\n            <h4 className=\"text-xs uppercase tracking-widest text-[#C5A059] font-bold\">\n              Store & Orders\n            </h4>\n            <div className=\"space-y-3 text-xs sm:text-sm text-[#D5CEC4]\">\n              <div className=\"flex items-start gap-2.5\">\n                <MapPin className=\"w-4 h-4 text-[#C5A059] shrink-0 mt-0.5\" />\n                <span>\n                  {BUSINESS_INFO.address}\n                </span>\n              </div>\n\n              <div className=\"flex items-center gap-2.5\">\n                <Phone className=\"w-4 h-4 text-[#C5A059] shrink-0\" />\n                <a href={`tel:${BUSINESS_INFO.phoneRaw}`} className=\"hover:text-white font-medium\">\n                  {BUSINESS_INFO.phone}\n                </a>\n              </div>\n\n              <div className=\"flex items-center gap-2.5\">\n                <MessageCircle className=\"w-4 h-4 text-[#25D366] shrink-0\" />\n                <a \n                  href={BUSINESS_INFO.whatsappUrl} \n                  target=\"_blank\" \n                  rel=\"noopener noreferrer\"\n                  className=\"hover:text-white font-medium\"\n                >\n                  WhatsApp: {BUSINESS_INFO.phone}\n                </a>\n              </div>\n\n              <div className=\"flex items-start gap-2.5 pt-1 text-xs text-[#8C8275]\">\n                <Clock className=\"w-4 h-4 text-[#C5A059] shrink-0 mt-0.5\" />\n                <span>{BUSINESS_INFO.openingHours}</span>\n              </div>\n\n              <div className=\"flex items-start gap-2.5 text-xs text-[#8C8275]\">\n                <Truck className=\"w-4 h-4 text-[#C5A059] shrink-0 mt-0.5\" />\n                <span>Nationwide delivery via motor park waybills & couriers</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Clean, Refined Bottom Closing Frame (Exact requested content & hierarchy) */}\n        <div className=\"pt-10 border-t border-[#26221F] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#8C8275] text-center md:text-left font-normal\">\n          <div className=\"flex flex-col sm:flex-row items-center gap-2 sm:gap-6\">\n            <p className=\"text-[#A89E91]\">\n              \302\251 {currentYear} Pearls Elegance Thrift Abaya Wears. All rights reserved.\n            </p>\n            <p className=\"text-[#7A7268]\">\n              Designed & Engineered by <span className=\"text-[#C5A059] font-medium\">Namaco Technology Nigeria Limited</span>.\n            </p>\n          </div>\n\n          <p className=\"text-[#7A7268]\">\n            Ijebu Ode, Ogun State, Nigeria\n          </p>\n        </div>\n\n      </div>\n    </footer>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
