      replacement_content: "import React from \'react\';\nimport { Star, ShieldCheck } from \'lucide-react\';\nimport { BUSINESS_INFO } from \'../data/products\';\n\ninterface TrustRatingBadgeProps {\n  variant?: \'compact\' | \'detailed\' | \'card\';\n}\n\nexport const TrustRatingBadge: React.FC<TrustRatingBadgeProps> = ({ variant = \'detailed\' }) => {\n  if (variant === \'compact\') {\n    return (\n      <div \n        id=\"google-rating-compact\" \n        className=\"inline-flex items-center gap-1.5 bg-[#FAF8F5] border border-[#E5DFD7] px-3 py-1.5 rounded-full text-xs\"\n      >\n        <div className=\"flex items-center text-[#D97706]\">\n          {[...Array(5)].map((_, i) => (\n            <Star key={i} className=\"w-3.5 h-3.5 fill-[#D97706]\" />\n          ))}\n        </div>\n        <span className=\"font-bold text-[#1C1917]\">{BUSINESS_INFO.googleRating.toFixed(1)}</span>\n        <span className=\"text-[#6B655D] text-[11px]\">({BUSINESS_INFO.reviewCount} Google review)</span>\n      </div>\n    );\n  }\n\n  if (variant === \'card\') {\n    return (\n      <div \n        id=\"google-rating-card\" \n        className=\"bg-white border border-[#EAE2D7] p-6 rounded-2xl shadow-xs\"\n      >\n        <div className=\"flex items-center justify-between gap-4 mb-3\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-[#FAF0DE] flex items-center justify-center text-[#8C6D37]\">\n              <ShieldCheck className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <p className=\"text-xs uppercase tracking-wider text-[#6B655D] font-semibold\">Google Verified Rating</p>\n              <h4 className=\"font-serif text-lg font-bold text-[#1C1917]\">5.0 Out of 5.0 Stars</h4>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-0.5 text-[#D97706]\">\n            {[...Array(5)].map((_, i) => (\n              <Star key={i} className=\"w-4 h-4 fill-[#D97706]\" />\n            ))}\n          </div>\n        </div>\n        <p className=\"text-sm text-[#5A544C] leading-relaxed\">\n          Verified rating on Google Maps based on customer satisfaction for modest thrift wear quality and friendly service in Ijebu Ode.\n        </p>\n        <div className=\"mt-3 pt-3 border-t border-[#F2EBE1] flex items-center justify-between text-xs text-[#6B655D]\">\n          <span>Verified Business Listing</span>\n          <span className=\"font-medium text-[#1C1917]\">1 Google Review</span>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div \n      id=\"google-rating-detailed\" \n      className=\"inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-4 bg-[#F5EFE6] border border-[#E2D6C5] px-4 py-2.5 rounded-2xl\"\n    >\n      <div className=\"flex items-center gap-1 text-[#D97706]\">\n        {[...Array(5)].map((_, i) => (\n          <Star key={i} className=\"w-4 h-4 fill-[#D97706]\" />\n        ))}\n      </div>\n      <div className=\"text-center sm:text-left\">\n        <span className=\"text-sm font-bold text-[#1C1917]\">5.0 \342\230\205 Google Rating</span>\n        <span className=\"text-xs text-[#6B655D] ml-1.5\">\342\200\242 1 Google review</span>\n      </div>\n    </div>\n  );\n};\n"
    }
