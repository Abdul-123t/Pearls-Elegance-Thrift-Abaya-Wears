        target_content: "      {/* 5. EDITORIAL TESTIMONIALS / WHAT OUR CUSTOMERS SAY */}\n      <section id=\"testimonials-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#FAF8F5] border border-[#EAE2D7] rounded-3xl p-8 sm:p-12\">\n          <div className=\"text-center max-w-2xl mx-auto mb-10\">\n            <span className=\"text-xs uppercase tracking-[0.2em] text-[#8C6D37] font-semibold\">\n              Verified Experience\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1 mb-2\">\n              What Our Customers Say\n            </h2>\n            <p className=\"text-sm text-[#5A544C]\">\n              Genuine customer satisfaction from everyday modest wear buyers and boutique resellers.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {/* Review 1 - Google Reviewer */}\n            <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center gap-1 text-[#D97706] mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-[#D97706]\" />\n                  ))}\n                </div>\n                <p className=\"text-xs sm:text-sm text-[#4A453E] leading-relaxed italic mb-4\">\n                  &ldquo;The best modest fashion thrift store in Ijebu Ode! The abayas are in pristine condition, very clean and well pressed. Fast replies on WhatsApp too.&rdquo;\n                </p>\n              </div>\n              <div className=\"pt-3 border-t border-[#F5EFE6] flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-[#1C1917]\">Verified Google Customer</span>\n                <span className=\"text-[#8A847C]\">Ijebu Ode</span>\n              </div>\n            </div>\n\n            {/* Review 2 - Online Buyer */}\n            <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center gap-1 text-[#D97706] mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-[#D97706]\" />\n                  ))}\n                </div>\n                <p className=\"text-xs sm:text-sm text-[#4A453E] leading-relaxed italic mb-4\">\n                  &ldquo;I bought the thrift kinomo with inner dress set for \342\202\24612,000. It arrived in Lagos neatly steam-ironed. Highly recommend for affordable modesty!&rdquo;\n                </p>\n              </div>\n              <div className=\"pt-3 border-t border-[#F5EFE6] flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-[#1C1917]\">Halimat A.</span>\n                <span className=\"text-[#8A847C]\">Lagos Delivery</span>\n              </div>\n            </div>\n\n            {/* Review 3 - Reseller */}\n            <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center gap-1 text-[#D97706] mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-[#D97706]\" />\n                  ))}\n                </div>\n                <p className=\"text-xs sm:text-sm text-[#4A453E] leading-relaxed italic mb-4\">\n                  &ldquo;Ordered a wholesale bale of jalabiyas and abayas for my boutique. Every piece was Grade-A quality and my customers bought them all within two weeks.&rdquo;\n                </p>\n              </div>\n              <div className=\"pt-3 border-t border-[#F5EFE6] flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-[#1C1917]\">Maryam K.</span>\n                <span className=\"text-[#8A847C]\">Boutique Owner</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>"
        replacement_content: "      {/* 5. EDITORIAL TESTIMONIALS / WHAT OUR CUSTOMERS SAY */}\n      <section id=\"testimonials-section\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#FAF8F5] border border-[#EAE2D7] rounded-3xl p-8 sm:p-12\">\n          <div className=\"text-center max-w-2xl mx-auto mb-10\">\n            <span className=\"text-xs uppercase tracking-[0.2em] text-[#8C6D37] font-semibold\">\n              Client Experiences\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#1C1917] mt-1 mb-2\">\n              WHAT OUR CUSTOMERS SAY\n            </h2>\n            <p className=\"text-sm text-[#5A544C]\">\n              Genuine feedback from retail customers and boutique owners who shop with Pearls Elegance.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {/* Review 1 */}\n            <div className=\"bg-white p-6 sm:p-7 rounded-2xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center gap-1 text-[#C5A059] mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-[#C5A059]\" />\n                  ))}\n                </div>\n                <p className=\"text-xs sm:text-sm text-[#4A453E] leading-relaxed italic mb-4\">\n                  &ldquo;The best modest fashion thrift store in Ijebu Ode! The abayas are in pristine condition, very clean and well pressed. Fast replies on WhatsApp too.&rdquo;\n                </p>\n              </div>\n              <div className=\"pt-3 border-t border-[#F5EFE6] flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-[#1C1917]\">Store Customer</span>\n                <span className=\"text-[#8A847C]\">Ijebu Ode</span>\n              </div>\n            </div>\n\n            {/* Review 2 - Online Buyer */}\n            <div className=\"bg-white p-6 sm:p-7 rounded-2xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center gap-1 text-[#C5A059] mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-[#C5A059]\" />\n                  ))}\n                </div>\n                <p className=\"text-xs sm:text-sm text-[#4A453E] leading-relaxed italic mb-4\">\n                  &ldquo;I bought the thrift kinomo with inner dress set for \342\202\24612,000. It arrived in Lagos neatly steam-ironed. Highly recommend for affordable modesty!&rdquo;\n                </p>\n              </div>\n              <div className=\"pt-3 border-t border-[#F5EFE6] flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-[#1C1917]\">Halimat A.</span>\n                <span className=\"text-[#8A847C]\">Lagos Delivery</span>\n              </div>\n            </div>\n\n            {/* Review 3 - Reseller */}\n            <div className=\"bg-white p-6 sm:p-7 rounded-2xl border border-[#EAE2D7] shadow-xs flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center gap-1 text-[#C5A059] mb-3\">\n                  {[...Array(5)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-[#C5A059]\" />\n                  ))}\n                </div>\n                <p className=\"text-xs sm:text-sm text-[#4A453E] leading-relaxed italic mb-4\">\n                  &ldquo;Ordered a wholesale bale of jalabiyas and abayas for my boutique. Every piece was Grade-A quality and my customers bought them all within two weeks.&rdquo;\n                </p>\n              </div>\n              <div className=\"pt-3 border-t border-[#F5EFE6] flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-[#1C1917]\">Maryam K.</span>\n                <span className=\"text-[#8A847C]\">Boutique Owner</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>"
