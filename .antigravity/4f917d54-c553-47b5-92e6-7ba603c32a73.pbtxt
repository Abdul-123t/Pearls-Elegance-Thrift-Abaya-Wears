  file_change {
    absolute_path_uri: "file:///src/views/WholesaleView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { \n  Package, \n  MessageCircle, \n  CheckCircle2, \n  Store, \n  TrendingUp, \n  Truck, \n  ShieldCheck, \n  Send,\n  Sparkles,\n  Phone\n} from \'lucide-react\';\nimport { WholesaleInquiryData } from \'../types\';\nimport { getWholesaleWhatsAppUrl } from \'../utils/whatsapp\';\nimport { BUSINESS_INFO } from \'../data/products\';\n\nexport const WholesaleView: React.FC = () => {\n  const [formData, setFormData] = useState<WholesaleInquiryData>({\n    name: \'\',\n    businessName: \'\',\n    phone: \'\',\n    productsInterested: [\'Abayas\', \'Jalabiyas\'],\n    quantityNeeded: \'10 - 25 pieces (Bale / Starter pack)\',\n    deliveryLocation: \'\',\n    message: \'\',\n  });\n\n  const [submitted, setSubmitted] = useState(false);\n\n  const productOptions = [\n    \'Thrift Abayas (\342\202\2469k tier)\',\n    \'New Arrival Abayas (\342\202\24612k tier)\',\n    \'Adult Jalabias (\342\202\2466k tier)\',\n    \'Thrift Kinomo 2-Piece Sets\',\n    \'Kiddies Abaya & Jalabia\',\n    \'Thrift Tops & Gowns (\342\202\2462k budget lot)\',\n    \'Mixed Assorted Bale (50+ pcs)\'\n  ];\n\n  const handleProductToggle = (option: string) => {\n    if (formData.productsInterested.includes(option)) {\n      setFormData({\n        ...formData,\n        productsInterested: formData.productsInterested.filter((item) => item !== option),\n      });\n    } else {\n      setFormData({\n        ...formData,\n        productsInterested: [...formData.productsInterested, option],\n      });\n    }\n  };\n\n  const handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const url = getWholesaleWhatsAppUrl(formData);\n    window.open(url, \'_blank\');\n    setSubmitted(true);\n  };\n\n  const directWholesaleUrl = getWholesaleWhatsAppUrl();\n\n  return (\n    <div id=\"wholesale-view\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12\">\n      \n      {/* Hero Wholesale Banner */}\n      <div className=\"bg-gradient-to-br from-[#1C1917] via-[#2D2824] to-[#1C1917] text-white rounded-3xl p-8 sm:p-12 border border-[#3A3530] shadow-xl\">\n        <div className=\"max-w-3xl space-y-4\">\n          <div className=\"inline-flex items-center gap-1.5 bg-[#C5A059] text-[#1C1917] text-xs uppercase tracking-wider font-bold px-3.5 py-1 rounded-full\">\n            <Package className=\"w-3.5 h-3.5\" />\n            Wholesale & B2B Resellers\n          </div>\n\n          <h1 \n            id=\"wholesale-headline\"\n            className=\"font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight\"\n          >\n            Stock Your Store With Affordable Modest Fashion.\n          </h1>\n\n          <p className=\"text-sm sm:text-base text-[#D5CEC4] leading-relaxed\">\n            Pearls Elegance Thrift Abaya Wears supplies boutique owners, Instagram fashion vendors, and market traders across Nigeria with washed, sorted, and high-turnover thrift abayas, jalabiyas, and modest gowns.\n          </p>\n\n          <div className=\"pt-3 flex flex-col sm:flex-row gap-3\">\n            <a\n              id=\"direct-wholesale-whatsapp-btn\"\n              href={directWholesaleUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold px-6 py-3.5 rounded-full shadow-md transition-all text-xs sm:text-sm\"\n            >\n              <MessageCircle className=\"w-4 h-4 fill-white\" />\n              <span>Contact Us on WhatsApp for Bulk Rates</span>\n            </a>\n\n            <a\n              id=\"wholesale-call-btn\"\n              href={`tel:${BUSINESS_INFO.phoneRaw}`}\n              className=\"inline-flex items-center justify-center gap-2 bg-[#FAF8F5]/10 hover:bg-[#FAF8F5]/20 text-white border border-[#EAE2D7]/30 font-medium px-6 py-3.5 rounded-full transition-all text-xs sm:text-sm\"\n            >\n              <Phone className=\"w-4 h-4 text-[#C5A059]\" />\n              <span>Call Wholesale Desk: 0811 244 4087</span>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      {/* Target Buyer Categories & Advantages */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center mb-4\">\n            <Store className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n            Boutique Owners\n          </h3>\n          <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n            Expand your physical store inventory with high-grade, pre-ironed abayas and modest dresses that your local customers will love.\n          </p>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center mb-4\">\n            <TrendingUp className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n            Online & IG Resellers\n          </h3>\n          <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n            Start or grow your online fashion business with starter packs of 10 to 30 pieces. Enjoy healthy profit margins with budget entry prices.\n          </p>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center mb-4\">\n            <Truck className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n            Nationwide Waybill\n          </h3>\n          <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n            Direct dispatch from Ibadan Garage, Ijebu Ode via trusted logistics to all states including Lagos, Ibadan, Abeokuta, Port Harcourt, and Abuja.\n          </p>\n        </div>\n      </div>\n\n      {/* Wholesale Inquiry Form */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\">\n        \n        {/* Form Column */}\n        <div className=\"lg:col-span-7 bg-white p-6 sm:p-8 rounded-3xl border border-[#EAE2D7] shadow-xs\">\n          <div className=\"mb-6\">\n            <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n              Fast Inquiry Submission\n            </span>\n            <h2 className=\"font-serif text-2xl sm:text-3xl font-bold text-[#1C1917] mt-1\">\n              Wholesale / Bulk Request Form\n            </h2>\n            <p className=\"text-xs text-[#6B655D] mt-1\">\n              Fill out this quick form and click submit to instantly send your custom order requirements to our WhatsApp manager.\n            </p>\n          </div>\n\n          <form onSubmit={handleFormSubmit} className=\"space-y-4\">\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Your Full Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Fatima Adebayo\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Business / Store Name\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Modest Glow Boutique\"\n                  value={formData.businessName}\n                  onChange={(e) => setFormData({ ...formData, businessName: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Phone / WhatsApp Number *\n                </label>\n                <input\n                  type=\"tel\"\n                  required\n                  placeholder=\"e.g. 08012345678\"\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Delivery Destination (City/State)\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Ikeja Lagos / Ibadan\"\n                  value={formData.deliveryLocation}\n                  onChange={(e) => setFormData({ ...formData, deliveryLocation: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1C1917] mb-2\">\n                Products You Are Interested In:\n              </label>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                {productOptions.map((opt) => {\n                  const isChecked = formData.productsInterested.includes(opt);\n                  return (\n                    <button\n                      type=\"button\"\n                      key={opt}\n                      onClick={() => handleProductToggle(opt)}\n                      className={`p-2.5 rounded-xl border text-left text-xs font-medium flex items-center justify-between transition-colors ${\n                        isChecked \n                          ? \'bg-[#FAF0DE] border-[#C5A059] text-[#8C6D37] font-semibold\' \n                          : \'bg-[#FAF8F5] border-[#EAE2D7] text-[#5A544C] hover:bg-[#F2EBE1]\'\n                      }`}\n                    >\n                      <span>{opt}</span>\n                      {isChecked && <CheckCircle2 className=\"w-4 h-4 text-[#8C6D37]\" />}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                Estimated Quantity Needed\n              </label>\n              <select\n                value={formData.quantityNeeded}\n                onChange={(e) => setFormData({ ...formData, quantityNeeded: e.target.value })}\n                className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n              >\n                <option value=\"5 - 10 pieces (Sample Pack)\">5 - 10 pieces (Sample Pack)</option>\n                <option value=\"10 - 25 pieces (Bale / Starter pack)\">10 - 25 pieces (Bale / Starter pack)</option>\n                <option value=\"25 - 50 pieces (Vendor Pack)\">25 - 50 pieces (Vendor Pack)</option>\n                <option value=\"50 - 100+ pieces (Bulk Bale)\">50 - 100+ pieces (Bulk Bale)</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                Additional Note / Specific Styles\n              </label>\n              <textarea\n                rows={3}\n                placeholder=\"Let us know any specific colors, sizes, or questions...\"\n                value={formData.message}\n                onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n              ></textarea>\n            </div>\n\n            <button\n              id=\"submit-wholesale-inquiry-btn\"\n              type=\"submit\"\n              className=\"w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl flex items-center justify-center gap-2 shadow-md transition-all text-sm text-center\"\n            >\n              <MessageCircle className=\"w-5 h-5 fill-white\" />\n              <span>Send Wholesale Request via WhatsApp</span>\n            </button>\n\n            {submitted && (\n              <p className=\"text-xs text-[#2E7D32] text-center font-medium\">\n                Opening WhatsApp with your filled inquiry details...\n              </p>\n            )}\n          </form>\n        </div>\n\n        {/* Wholesale FAQ & Trust Notes */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          <div className=\"bg-[#F5EFE6] p-6 rounded-3xl border border-[#E2D6C5]\">\n            <h3 className=\"font-serif text-xl font-bold text-[#1C1917] mb-3\">\n              Wholesale Buying Process\n            </h3>\n            \n            <ol className=\"space-y-3.5 text-xs text-[#5A544C]\">\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  1\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Send Inquiry:</strong>\n                  Choose your product mix (Abayas, Jalabiyas, Kinomo sets, or Kiddies wear).\n                </div>\n              </li>\n\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  2\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Review Live Photos / Videos:</strong>\n                  We send photos and short videos of the exact batch available.\n                </div>\n              </li>\n\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  3\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Inspection & Ironing:</strong>\n                  Every piece is inspected, freshly pressed, and sorted before packing.\n                </div>\n              </li>\n\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  4\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Direct Waybill Dispatch:</strong>\n                  We dispatch your bulk order via reliable park or door delivery with tracking.\n                </div>\n              </li>\n            </ol>\n          </div>\n\n          <div className=\"p-6 bg-white rounded-3xl border border-[#EAE2D7] text-xs text-[#5A544C] space-y-2\">\n            <h4 className=\"font-bold text-[#1C1917]\">Store Location in Ijebu Ode</h4>\n            <p>\n              You or your representative in Ogun State can also visit our physical store at Ibadan Garage Side, Ijebu Ode to inspect bales in person.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Package, \n  MessageCircle, \n  CheckCircle2, \n  Store, \n  TrendingUp, \n  Truck, \n  ShieldCheck, \n  Send,\n  Sparkles,\n  Phone\n} from \'lucide-react\';\nimport { WholesaleInquiryData } from \'../types\';\nimport { getWholesaleWhatsAppUrl } from \'../utils/whatsapp\';\nimport { BUSINESS_INFO } from \'../data/products\';\n\nexport const WholesaleView: React.FC = () => {\n  const [formData, setFormData] = useState<WholesaleInquiryData>({\n    name: \'\',\n    businessName: \'\',\n    phone: \'\',\n    productsInterested: [\'Thrift Abayas\', \'Adult Jalabias\'],\n    quantityNeeded: \'\',\n    deliveryLocation: \'\',\n    message: \'\',\n  });\n\n  const [submitted, setSubmitted] = useState(false);\n\n  const productOptions = [\n    \'Thrift Abayas\',\n    \'New Arrival Abayas\',\n    \'Adult Jalabias (Clean White & Colors)\',\n    \'Thrift Kinomo with Inner Dress Sets\',\n    \'Kiddies Abaya & Jalabia\',\n    \'Thrift Tops & Gowns\',\n    \'Mixed Modest Wear Selection\'\n  ];\n\n  const handleProductToggle = (option: string) => {\n    if (formData.productsInterested.includes(option)) {\n      setFormData({\n        ...formData,\n        productsInterested: formData.productsInterested.filter((item) => item !== option),\n      });\n    } else {\n      setFormData({\n        ...formData,\n        productsInterested: [...formData.productsInterested, option],\n      });\n    }\n  };\n\n  const handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const url = getWholesaleWhatsAppUrl(formData);\n    window.open(url, \'_blank\');\n    setSubmitted(true);\n  };\n\n  const directWholesaleUrl = getWholesaleWhatsAppUrl();\n\n  return (\n    <div id=\"wholesale-view\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12\">\n      \n      {/* Hero Wholesale Banner */}\n      <div className=\"bg-[#1C1917] text-white rounded-3xl p-8 sm:p-12 border border-[#3A3530] shadow-xl\">\n        <div className=\"max-w-3xl space-y-4\">\n          <div className=\"inline-flex items-center gap-1.5 bg-[#C5A059] text-[#1C1917] text-xs uppercase tracking-wider font-bold px-3.5 py-1 rounded-full\">\n            <Package className=\"w-3.5 h-3.5\" />\n            Wholesale & Reseller Inquiries\n          </div>\n\n          <h1 \n            id=\"wholesale-headline\"\n            className=\"font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight\"\n          >\n            Stock Your Store With Affordable Modest Fashion.\n          </h1>\n\n          <p className=\"text-sm sm:text-base text-[#D5CEC4] leading-relaxed\">\n            Pearls Elegance Thrift Abaya Wears supplies boutique owners, online vendors, and fashion retailers across Nigeria with hand-selected, washed, and ironed thrift abayas, jalabiyas, and modest gowns at affordable rates.\n          </p>\n\n          <div className=\"pt-3 flex flex-col sm:flex-row gap-3\">\n            <a\n              id=\"direct-wholesale-whatsapp-btn\"\n              href={directWholesaleUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold px-6 py-3.5 rounded-full shadow-md transition-all text-xs sm:text-sm\"\n            >\n              <MessageCircle className=\"w-4 h-4 fill-white\" />\n              <span>Contact Us on WhatsApp for Bulk Rates</span>\n            </a>\n\n            <a\n              id=\"wholesale-call-btn\"\n              href={`tel:${BUSINESS_INFO.phoneRaw}`}\n              className=\"inline-flex items-center justify-center gap-2 bg-[#FAF8F5]/10 hover:bg-[#FAF8F5]/20 text-white border border-[#EAE2D7]/30 font-medium px-6 py-3.5 rounded-full transition-all text-xs sm:text-sm\"\n            >\n              <Phone className=\"w-4 h-4 text-[#C5A059]\" />\n              <span>Call Wholesale Desk: 0811 244 4087</span>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      {/* Target Buyer Categories & Advantages */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center mb-4\">\n            <Store className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n            Boutique Owners\n          </h3>\n          <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n            Expand your physical store inventory with hand-selected, pre-ironed abayas and modest dresses that your local customers will love.\n          </p>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center mb-4\">\n            <TrendingUp className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n            Online & IG Resellers\n          </h3>\n          <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n            Stock your online fashion boutique or status catalog with affordable modest pieces and enjoy fast inventory turnaround.\n          </p>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-[#EAE2D7] shadow-2xs\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#FAF0DE] text-[#8C6D37] flex items-center justify-center mb-4\">\n            <Truck className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"font-serif text-lg font-bold text-[#1C1917] mb-2\">\n            Delivery Across Nigeria\n          </h3>\n          <p className=\"text-xs text-[#5A544C] leading-relaxed\">\n            Reliable dispatch from our store in Ijebu Ode, Ogun State, delivering to customers and businesses across all states in Nigeria.\n          </p>\n        </div>\n      </div>\n\n      {/* Wholesale Inquiry Form */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\">\n        \n        {/* Form Column */}\n        <div className=\"lg:col-span-7 bg-white p-6 sm:p-8 rounded-3xl border border-[#EAE2D7] shadow-xs\">\n          <div className=\"mb-6\">\n            <span className=\"text-xs uppercase tracking-widest text-[#8C6D37] font-semibold\">\n              Reseller & Bulk Inquiries\n            </span>\n            <h2 className=\"font-serif text-2xl sm:text-3xl font-bold text-[#1C1917] mt-1\">\n              Wholesale Inquiry Form\n            </h2>\n            <p className=\"text-xs text-[#6B655D] mt-1\">\n              Complete the details below to message us directly on WhatsApp with your wholesale requirements.\n            </p>\n          </div>\n\n          <form onSubmit={handleFormSubmit} className=\"space-y-4\">\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"Your full name\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Business Name\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"Store / Brand name\"\n                  value={formData.businessName}\n                  onChange={(e) => setFormData({ ...formData, businessName: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Phone Number *\n                </label>\n                <input\n                  type=\"tel\"\n                  required\n                  placeholder=\"0811 244 4087\"\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                  Quantity Needed\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. 10 pieces, 20 pieces, bulk pack\"\n                  value={formData.quantityNeeded}\n                  onChange={(e) => setFormData({ ...formData, quantityNeeded: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1C1917] mb-2\">\n                Products Interested In:\n              </label>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                {productOptions.map((opt) => {\n                  const isChecked = formData.productsInterested.includes(opt);\n                  return (\n                    <button\n                      type=\"button\"\n                      key={opt}\n                      onClick={() => handleProductToggle(opt)}\n                      className={`p-2.5 rounded-xl border text-left text-xs font-medium flex items-center justify-between transition-colors ${\n                        isChecked \n                          ? \'bg-[#FAF0DE] border-[#C5A059] text-[#8C6D37] font-semibold\' \n                          : \'bg-[#FAF8F5] border-[#EAE2D7] text-[#5A544C] hover:bg-[#F2EBE1]\'\n                      }`}\n                    >\n                      <span>{opt}</span>\n                      {isChecked && <CheckCircle2 className=\"w-4 h-4 text-[#8C6D37]\" />}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1C1917] mb-1\">\n                Message / Specifications\n              </label>\n              <textarea\n                rows={3}\n                placeholder=\"Let us know any specific styles, sizes, or delivery destination...\"\n                value={formData.message}\n                onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                className=\"w-full px-3.5 py-2.5 bg-[#FAF8F5] border border-[#D9CFC4] rounded-xl text-xs sm:text-sm text-[#1C1917] focus:outline-none focus:border-[#8C6D37]\"\n              ></textarea>\n            </div>\n\n            <button\n              id=\"submit-wholesale-inquiry-btn\"\n              type=\"submit\"\n              className=\"w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20BE5B] text-white font-semibold rounded-2xl flex items-center justify-center gap-2 shadow-md transition-all text-sm text-center\"\n            >\n              <MessageCircle className=\"w-5 h-5 fill-white\" />\n              <span>Send Wholesale Inquiry</span>\n            </button>\n\n            {submitted && (\n              <p className=\"text-xs text-[#2E7D32] text-center font-medium\">\n                Opening WhatsApp with your filled inquiry details...\n              </p>\n            )}\n          </form>\n        </div>\n\n        {/* Wholesale FAQ & Trust Notes */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          <div className=\"bg-[#F5EFE6] p-6 rounded-3xl border border-[#E2D6C5]\">\n            <h3 className=\"font-serif text-xl font-bold text-[#1C1917] mb-3\">\n              How Wholesale Inquiries Work\n            </h3>\n            \n            <ol className=\"space-y-3.5 text-xs text-[#5A544C]\">\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  1\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Send Your Inquiry:</strong>\n                  Select the types and quantities of modest pieces you would like to stock.\n                </div>\n              </li>\n\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  2\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Review Photos & Available Pieces:</strong>\n                  We send photos of current stock matching your request.\n                </div>\n              </li>\n\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  3\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Clean & Neatly Packed:</strong>\n                  Every item is checked, washed, pressed, and packed before dispatch.\n                </div>\n              </li>\n\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"w-5 h-5 rounded-full bg-[#1C1917] text-white flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5\">\n                  4\n                </span>\n                <div>\n                  <strong className=\"text-[#1C1917] block\">Delivery / In-Store Pickup:</strong>\n                  Pickup in our Ijebu Ode store or receive reliable delivery across Nigeria.\n                </div>\n              </li>\n            </ol>\n          </div>\n\n          <div className=\"p-6 bg-white rounded-3xl border border-[#EAE2D7] text-xs text-[#5A544C] space-y-2\">\n            <h4 className=\"font-bold text-[#1C1917]\">Physical Store in Ijebu Ode</h4>\n            <p>\n              You or your representative in Ogun State can also visit our physical store at Ibadan Garage Side, Ijebu Ode to inspect items in person.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
